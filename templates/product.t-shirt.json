            "ai_gen_block_0558575_EUwxiw": {
              "type": "ai_gen_block_0558575",
              "settings": {
                "tab_1_title": "Product details",
                "tab_1_icon": "info",
                "tab_1_content": "<h2>PRODUCT DETAILS</h2><p>Create a meaningful, one-of-a-kind gift with our personalized Comfort Colors 1717 T-shirt. Made from soft, garment-dyed cotton, this custom shirt offers a comfortable relaxed fit and a timeless vintage look.</p><ul><li>Comfort Colors 1717</li><li>6.1 oz, 100% ring-spun US cotton</li><li>Soft-washed, garment-dyed fabric</li><li>Relaxed unisex fit</li><li>Durable ribbed collar and reinforced seams</li><li>Professionally printed in the USA</li><li>Perfect for birthdays, holidays and personalized gifts</li></ul><h2>HOW TO ORDER</h2><ol><li>Select your size and shirt color.</li><li>Enter the required personalization details.</li><li>Review the spelling, photo and options carefully.</li><li>Preview your design, then complete checkout.</li></ol><p>Please check the size chart before ordering. Designs may appear slightly smaller on sizes S and M due to the available print area.</p><h2>CARE INSTRUCTIONS</h2><ul><li>Wash inside out in cold water</li><li>Use mild detergent</li><li>Do not bleach or dry clean</li><li>Tumble dry on low or hang dry</li><li>Do not iron directly on the design</li></ul><h2>PRODUCTION & SHIPPING</h2><ul><li>Production time: 3–5 business days</li><li>Standard US shipping: 1–7 business days</li><li>Express shipping: 2–3 business days</li></ul><p>Delivery dates are estimates and may be affected by carrier delays, holidays or customs processing.</p><h2>RETURNS & REPLACEMENTS</h2><p>Personalized items cannot be returned or refunded for incorrect size, color or customization provided by the customer.</p><p>For printing errors, defects or damage, contact us within 30 days of delivery with clear photos. Changes or cancellations must be requested within 3 hours of purchase.</p><p>Colors may vary slightly due to screen settings, lighting and the garment-dyeing process.</p><p>Thank you for supporting us! ❤️</p>",
                "tab_1_open": true,
                "tab_2_title": "Shipping & returns",
                "tab_2_icon": "truck",
                "tab_2_content": "<h2>RETURNS & REPLACEMENTS</h2><p>Personalized items cannot be returned or refunded for incorrect size, color or customization provided by the customer.</p><p>For printing errors, defects or damage, contact us within 21 days of delivery with clear photos. Changes or cancellations must be requested within 3 hours of purchase.</p><p>Colors may vary slightly due to screen settings, lighting and the garment-dyeing process.</p>",
                "tab_2_open": false,
                "tab_3_title": "Care instructions",
                "tab_3_icon": "heart",
                "tab_3_content": "<h2>🧼 Care Instructions</h2><ul><li>Turn garment inside out before washing.</li><li>Wash cold on a gentle cycle.</li><li>Use mild detergent.</li><li>Do not bleach or dry clean.</li><li>Do not iron directly on the design.</li><li>Hang dry or tumble dry on low heat.</li></ul>",
                "tab_3_open": false,
