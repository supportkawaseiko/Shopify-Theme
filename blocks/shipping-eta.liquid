{%- liquid
  assign block_settings = block.settings
  assign metafield_namespace = block_settings.metafield_namespace | strip
  assign metafield_key = block_settings.metafield_key | strip
  assign shipping_metafield = blank
  assign eta_value = blank
  assign is_eta_list = false

  if metafield_namespace != blank and metafield_key != blank
    assign shipping_metafield = closest.product.metafields[metafield_namespace][metafield_key]
    assign eta_value = shipping_metafield.value

    if shipping_metafield.type contains 'list.'
      assign is_eta_list = true
    endif
  endif
-%}

{%- if eta_value != blank -%}
  <div
    class="shipping-eta spacing-style"
    style="{% render 'spacing-style', settings: block_settings %}"
    {{ block.shopify_attributes }}
  >
    {%- if is_eta_list -%}
      {%- capture region_rows -%}
        {%- for eta in eta_value -%}
          {% render 'shipping-eta-entry', eta: eta, settings: block_settings, mode: 'row' %}
        {%- endfor -%}
      {%- endcapture -%}

      {%- if region_rows != blank -%}
        {%- if block_settings.region_heading != blank -%}
          <p class="shipping-eta__headline">
            <span class="shipping-eta__truck" aria-hidden="true">
              <svg viewBox="0 0 24 24" focusable="false">
                <path d="M3 6.5h11v9H3z" />
                <path d="M14 9h3.6l2.4 3.2v3.3h-6z" />
                <circle cx="7" cy="17" r="1.7" />
                <circle cx="17.5" cy="17" r="1.7" />
                <path d="M1.5 9h4M.5 12h5M2 15h3.5" />
              </svg>
            </span>
            <span>{{ block_settings.region_heading | escape }}</span>
          </p>
        {%- endif -%}

        <div class="shipping-eta__regions" aria-label="{{ block_settings.regions_accessibility_label | escape }}">
          <div class="shipping-eta__region-header" aria-hidden="true">
            <span>{{ block_settings.region_column_label | escape }}</span>
            <span>{{ block_settings.ship_label | escape }}</span>
            <span>{{ block_settings.arrival_label | escape }}</span>
          </div>
          {{ region_rows }}
        </div>
      {%- endif -%}
    {%- else -%}
      {% render 'shipping-eta-entry', eta: eta_value, settings: block_settings, mode: 'timeline' %}
    {%- endif -%}
  </div>
{%- endif -%}

{% stylesheet %}
  .shipping-eta {
    color: rgb(var(--color-foreground-rgb));
    display: grid;
    gap: var(--gap-md);
  }

  .shipping-eta__headline {
    align-items: center;
    display: flex;
    font-size: var(--font-paragraph--size);
    gap: var(--gap-xs);
    line-height: var(--font-paragraph--line-height);
    margin: 0;
  }

  .shipping-eta__headline strong,
  .shipping-eta__date,
  .shipping-eta__region-cell strong {
    font-weight: var(--font-weight-semibold);
  }

  .shipping-eta__truck,
  .shipping-eta__icon {
    align-items: center;
    display: inline-flex;
    flex-shrink: 0;
    justify-content: center;
  }

  .shipping-eta__truck {
    color: currentColor;
    height: 1.5rem;
    width: 1.8rem;
  }

  .shipping-eta svg {
    display: block;
    fill: none;
    height: 100%;
    stroke: currentColor;
    stroke-linecap: round;
    stroke-linejoin: round;
    stroke-width: 2;
    width: 100%;
  }

  .shipping-eta__timeline {
    display: grid;
    gap: var(--gap-sm);
    grid-template-columns: repeat(3, minmax(0, 1fr));
    position: relative;
  }

  .shipping-eta__timeline::before {
    background: rgb(var(--color-foreground-rgb) / 0.14);
    content: '';
    height: 1px;
    inset-block-start: 18px;
    inset-inline: 10%;
    position: absolute;
  }

  .shipping-eta__step {
    display: grid;
    gap: var(--gap-3xs);
    justify-items: center;
    min-width: 0;
    position: relative;
    text-align: center;
  }

  .shipping-eta__icon {
    background: rgb(var(--color-background-rgb));
    border-radius: 50%;
    color: rgb(var(--color-foreground-rgb));
    height: 36px;
    padding: 8px;
    width: 36px;
    z-index: 1;
  }

  .shipping-eta__date,
  .shipping-eta__label,
  .shipping-eta__note,
  .shipping-eta__region-note,
  .shipping-eta__region-cell {
    margin: 0;
  }

  .shipping-eta__date {
    color: rgb(var(--color-button));
    font-size: var(--font-paragraph-small--size);
  }

  .shipping-eta__label {
    font-size: var(--font-paragraph-small--size);
  }

  .shipping-eta__note,
  .shipping-eta__region-note {
    color: rgb(var(--color-button));
    font-size: var(--font-paragraph-small--size);
    font-style: italic;
    line-height: var(--font-paragraph--line-height);
  }

  .shipping-eta__note > *,
  .shipping-eta__region-note > * {
    margin-block: 0;
  }

  .shipping-eta__regions {
    border-block: 1px solid rgb(var(--color-foreground-rgb) / 0.14);
    display: grid;
  }

  .shipping-eta__region-header,
  .shipping-eta__region-row {
    display: grid;
    gap: var(--gap-sm);
    grid-template-columns: 1fr 1fr 1fr;
  }

  .shipping-eta__region-header {
    color: rgb(var(--color-foreground-rgb) / var(--opacity-subdued-text));
    font-size: var(--font-paragraph-small--size);
    padding-block: var(--padding-xs);
  }

  .shipping-eta__region-row {
    border-block-start: 1px solid rgb(var(--color-foreground-rgb) / 0.1);
    padding-block: var(--padding-sm);
  }

  .shipping-eta__region-cell {
    font-size: var(--font-paragraph-small--size);
    line-height: var(--font-paragraph--line-height);
    min-width: 0;
  }

  .shipping-eta__region-name {
    font-weight: var(--font-weight-semibold);
  }

  .shipping-eta__region-note {
    grid-column: 1 / -1;
  }

  .shipping-eta__mobile-label {
    display: none;
  }

  @media screen and (max-width: 489px) {
    .shipping-eta__timeline {
      gap: var(--gap-md);
      grid-template-columns: 1fr;
    }

    .shipping-eta__timeline::before,
    .shipping-eta__region-header {
      display: none;
    }

    .shipping-eta__step {
      grid-template-columns: 36px 1fr;
      justify-items: start;
      text-align: left;
    }

    .shipping-eta__date,
    .shipping-eta__label {
      grid-column: 2;
    }

    .shipping-eta__icon {
      grid-row: 1 / span 2;
    }

    .shipping-eta__region-row {
      gap: var(--gap-xs);
      grid-template-columns: 1fr;
    }

    .shipping-eta__region-cell {
      display: grid;
      gap: var(--gap-xs);
      grid-template-columns: 8rem 1fr;
    }

    .shipping-eta__region-name {
      display: block;
      font-size: var(--font-paragraph--size);
    }

    .shipping-eta__mobile-label {
      color: rgb(var(--color-foreground-rgb) / var(--opacity-subdued-text));
      display: inline;
      font-weight: var(--font-weight-normal);
    }
  }
{% endstylesheet %}

