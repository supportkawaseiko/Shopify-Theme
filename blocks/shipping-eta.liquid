{%- liquid
  assign block_settings = block.settings
  assign metafield_namespace = block_settings.metafield_namespace | strip
  assign metafield_key = block_settings.metafield_key | strip
  assign shipping_metafield = blank
  assign eta_value = blank
  assign is_eta_list = false

  if metafield_namespace != blank and metafield_key != blank
    assign shipping_metafield = closest.product.metafields[metafield_namespace][metafield_key]
    assign eta_value = shipping_metafield.value

    if shipping_metafield.type contains 'list.'
      assign is_eta_list = true
    endif
  endif
-%}

{%- if eta_value != blank -%}
  <shipping-eta-selector
    class="shipping-eta spacing-style"
    style="{% render 'spacing-style', settings: block_settings %}"
    {{ block.shopify_attributes }}
  >
    <div class="shipping-eta__destination-control">
      <p class="shipping-eta__destination-label">{{ block_settings.destination_label | escape }}</p>

      <details class="shipping-eta__destination-dropdown" data-shipping-eta-dropdown>
        <summary
          class="shipping-eta__destination-trigger"
          aria-label="{{ block_settings.destination_label | escape }}"
        >
          {%- if is_eta_list -%}
            {%- for eta in eta_value -%}
              {%- if forloop.first -%}
                {% render 'shipping-eta-entry', eta: eta, settings: block_settings, mode: 'selected', selected: true %}
              {%- endif -%}
            {%- endfor -%}
          {%- else -%}
            {% render 'shipping-eta-entry', eta: eta_value, settings: block_settings, mode: 'selected', selected: true %}
          {%- endif -%}
          <span class="shipping-eta__chevron" aria-hidden="true">
            {{- 'icon-caret.svg' | inline_asset_content -}}
          </span>
        </summary>

        {%- if is_eta_list -%}
          <div class="shipping-eta__destination-options" role="listbox">
            {%- for eta in eta_value -%}
              {% render 'shipping-eta-entry',
                eta: eta,
                settings: block_settings,
                mode: 'option',
                index: forloop.index0,
                selected: forloop.first
              %}
            {%- endfor -%}
          </div>
        {%- endif -%}
      </details>
    </div>

    <div class="shipping-eta__panels">
      {%- if is_eta_list -%}
        {%- for eta in eta_value -%}
          {% render 'shipping-eta-entry',
            eta: eta,
            settings: block_settings,
            mode: 'panel',
            index: forloop.index0,
            selected: forloop.first
          %}
        {%- endfor -%}
      {%- else -%}
        {% render 'shipping-eta-entry', eta: eta_value, settings: block_settings, mode: 'panel', index: 0, selected: true %}
      {%- endif -%}
    </div>
  </shipping-eta-selector>
{%- endif -%}

<script>
  if (!customElements.get('shipping-eta-selector')) {
    customElements.define(
      'shipping-eta-selector',
      class ShippingEtaSelector extends HTMLElement {
        connectedCallback() {
          this.dropdown = this.querySelector('[data-shipping-eta-dropdown]');
          this.selectedFlag = this.querySelector('[data-shipping-eta-selected-flag]');
          this.selectedLabel = this.querySelector('[data-shipping-eta-selected-label]');
          this.options = Array.from(this.querySelectorAll('[data-shipping-eta-option]'));
          this.panels = Array.from(this.querySelectorAll('[data-shipping-eta-panel]'));

          this.options.forEach((option) => {
            option.addEventListener('click', () => this.selectOption(option));
          });
        }

        selectOption(option) {
          const selectedIndex = option.dataset.index;
          const optionFlag = option.querySelector('[data-shipping-eta-option-flag]');
          const optionLabel = option.querySelector('[data-shipping-eta-option-label]');

          if (this.selectedFlag && optionFlag) this.selectedFlag.innerHTML = optionFlag.innerHTML;
          if (this.selectedLabel && optionLabel) this.selectedLabel.textContent = optionLabel.textContent;

          this.options.forEach((item) => {
            item.setAttribute('aria-selected', item === option ? 'true' : 'false');
          });

          this.panels.forEach((panel) => {
            panel.hidden = panel.dataset.index !== selectedIndex;
          });

          if (this.dropdown) this.dropdown.open = false;
        }
      }
    );
  }
</script>

{% stylesheet %}
  .shipping-eta {
    color: rgb(var(--color-foreground-rgb));
    display: grid;
    gap: var(--gap-md);
  }

  .shipping-eta__destination-control {
    display: grid;
    gap: var(--gap-xs);
  }

  .shipping-eta__destination-label {
    font-size: var(--font-paragraph--size);
    font-weight: var(--font-weight-semibold);
    line-height: var(--font-paragraph--line-height);
    margin: 0;
  }

  .shipping-eta__destination-dropdown {
    position: relative;
  }

  .shipping-eta__destination-trigger {
    align-items: center;
    border: 1px solid rgb(var(--color-foreground-rgb) / 0.16);
    border-radius: var(--style-border-radius-inputs, 8px);
    cursor: pointer;
    display: grid;
    gap: var(--gap-xs);
    grid-template-columns: auto 1fr auto;
    list-style: none;
    min-height: 44px;
    padding: var(--padding-xs) var(--padding-sm);
  }

  .shipping-eta__destination-trigger::-webkit-details-marker {
    display: none;
  }

  .shipping-eta__destination-trigger:focus-visible {
    outline: var(--focus-outline-width) solid rgb(var(--color-foreground-rgb) / var(--opacity-35-55));
    outline-offset: var(--focus-outline-offset);
  }

  .shipping-eta__chevron {
    display: inline-flex;
    height: 12px;
    transition: transform var(--animation-speed) var(--animation-easing);
    width: 12px;
  }

  .shipping-eta__destination-dropdown[open] .shipping-eta__chevron {
    transform: rotate(180deg);
  }

  .shipping-eta__destination-options {
    background: rgb(var(--color-background-rgb));
    border: 1px solid rgb(var(--color-foreground-rgb) / 0.16);
    border-radius: var(--style-border-radius-inputs, 8px);
    box-shadow: var(--shadow-popover);
    display: grid;
    inset-block-start: calc(100% + var(--gap-3xs));
    inset-inline: 0;
    max-height: 240px;
    overflow: auto;
    padding: var(--padding-2xs);
    position: absolute;
    z-index: var(--layer-temporary);
  }

  .shipping-eta__destination-option {
    align-items: center;
    background: transparent;
    border: 0;
    border-radius: calc(var(--style-border-radius-inputs, 8px) / 2);
    color: currentColor;
    cursor: pointer;
    display: grid;
    font: inherit;
    gap: var(--gap-xs);
    grid-template-columns: auto 1fr;
    padding: var(--padding-xs);
    text-align: left;
  }

  .shipping-eta__destination-option:hover,
  .shipping-eta__destination-option[aria-selected='true'] {
    background: rgb(var(--color-foreground-rgb) / 0.06);
  }

  .shipping-eta__flag {
    align-items: center;
    background: rgb(var(--color-foreground-rgb) / 0.06);
    border-radius: 50%;
    display: inline-flex;
    height: 28px;
    justify-content: center;
    overflow: hidden;
    width: 28px;
  }

  .shipping-eta__flag:empty::before {
    color: rgb(var(--color-foreground-rgb) / var(--opacity-subdued-text));
    content: '-';
    font-size: var(--font-size--xs);
  }

  .shipping-eta__flag-image {
    display: block;
    height: 100%;
    object-fit: cover;
    width: 100%;
  }

  .shipping-eta__panels {
    display: grid;
  }

  .shipping-eta__panel {
    display: grid;
    gap: var(--gap-md);
  }

  .shipping-eta__panel[hidden] {
    display: none;
  }

  .shipping-eta__date,
  .shipping-eta__label,
  .shipping-eta__note {
    margin: 0;
  }

  .shipping-eta__date {
    color: rgb(var(--color-button));
    font-size: var(--font-paragraph-small--size);
    font-weight: var(--font-weight-semibold);
  }

  .shipping-eta__label {
    font-size: var(--font-paragraph-small--size);
  }

  .shipping-eta__note {
    color: rgb(var(--color-button));
    font-size: var(--font-paragraph-small--size);
    font-style: italic;
    line-height: var(--font-paragraph--line-height);
  }

  .shipping-eta__note > * {
    margin-block: 0;
  }

  .shipping-eta__timeline {
    display: grid;
    gap: var(--gap-sm);
    grid-template-columns: repeat(3, minmax(0, 1fr));
    position: relative;
  }

  .shipping-eta__timeline::before {
    background: rgb(var(--color-foreground-rgb) / 0.14);
    content: '';
    height: 1px;
    inset-block-start: 18px;
    inset-inline: 10%;
    position: absolute;
  }

  .shipping-eta__step {
    display: grid;
    gap: var(--gap-3xs);
    justify-items: center;
    min-width: 0;
    position: relative;
    text-align: center;
  }

  .shipping-eta__icon {
    align-items: center;
    background: rgb(var(--color-background-rgb));
    border-radius: 50%;
    color: rgb(var(--color-foreground-rgb));
    display: inline-flex;
    height: 36px;
    justify-content: center;
    padding: 8px;
    width: 36px;
    z-index: 1;
  }

  .shipping-eta svg {
    display: block;
    fill: none;
    height: 100%;
    stroke: currentColor;
    stroke-linecap: round;
    stroke-linejoin: round;
    stroke-width: 2;
    width: 100%;
  }

  @media screen and (max-width: 489px) {
    .shipping-eta__timeline {
      gap: var(--gap-md);
      grid-template-columns: 1fr;
    }

    .shipping-eta__timeline::before {
      display: none;
    }

    .shipping-eta__step {
      grid-template-columns: 36px 1fr;
      justify-items: start;
      text-align: left;
    }

    .shipping-eta__date,
    .shipping-eta__label {
      grid-column: 2;
    }

    .shipping-eta__icon {
      grid-row: 1 / span 2;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Shipping ETA",
  "tag": null,
  "settings": [
    {
      "type": "header",
      "content": "Product metafield"
    },
    {
      "type": "text",
      "id": "metafield_namespace",
      "label": "Namespace",
      "default": "custom"
    },
    {
      "type": "text",
      "id": "metafield_key",
      "label": "Key",
      "default": "shipping_eta",
      "info": "Use a product metafield that references one shipping ETA metaobject or a list of metaobjects."
    },
    {
      "type": "header",
      "content": "Metaobject fields"
    },
    {
      "type": "text",
      "id": "country_name_field",
      "label": "Country name field key",
      "default": "country_name",
      "info": "Used as the storefront label in the destination dropdown. Keep entry names internal, for example Apparel-US."
    },
    {
      "type": "text",
      "id": "region_field",
      "label": "Fallback region field key",
      "default": "region"
    },
    {
      "type": "text",
      "id": "flag_field",
      "label": "Flag image field key",
      "default": "flag"
    },
    {
      "type": "text",
      "id": "processing_min_field",
      "label": "Processing min days field key",
      "default": "processing_min_days"
    },
    {
      "type": "text",
      "id": "processing_max_field",
      "label": "Processing max days field key",
      "default": "processing_max_days"
    },
    {
      "type": "text",
      "id": "transit_min_field",
      "label": "Transit min days field key",
      "default": "transit_min_days"
    },
    {
      "type": "text",
      "id": "transit_max_field",
      "label": "Transit max days field key",
      "default": "transit_max_days"
    },
    {
      "type": "text",
      "id": "note_field",
      "label": "Note field key",
      "default": "note"
    },
    {
      "type": "header",
      "content": "Text"
    },
    {
      "type": "text",
      "id": "destination_label",
      "label": "Destination label",
      "default": "Where your package is shipped to"
    },
    {
      "type": "text",
      "id": "region_fallback_label",
      "label": "Region fallback label",
      "default": "Region"
    },
    {
      "type": "text",
      "id": "order_label",
      "label": "Order placed label",
      "default": "Order placed"
    },
    {
      "type": "text",
      "id": "ship_label",
      "label": "Order ships label",
      "default": "Order ships"
    },
    {
      "type": "text",
      "id": "arrival_label",
      "label": "Estimated arrival label",
      "default": "Estimated arrival"
    },
    {
      "type": "text",
      "id": "accessibility_label",
      "label": "Accessibility label",
      "default": "Shipping timeline"
    },
    {
      "type": "header",
      "content": "Padding"
    },
    {
      "type": "range",
      "id": "padding-block-start",
      "label": "Top",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding-block-end",
      "label": "Bottom",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding-inline-start",
