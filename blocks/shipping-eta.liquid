{%- liquid
  assign block_settings = block.settings
  assign metafield_namespace = block_settings.metafield_namespace | strip
  assign metafield_key = block_settings.metafield_key | strip
  assign shipping_metafield = blank
  assign eta_value = blank
  assign is_eta_list = false

  if metafield_namespace != blank and metafield_key != blank
    assign shipping_metafield = closest.product.metafields[metafield_namespace][metafield_key]
    assign eta_value = shipping_metafield.value

    if shipping_metafield.type contains 'list.'
      assign is_eta_list = true
    endif
  endif
-%}

{%- if eta_value != blank -%}
  <script
    src="{{ 'dialog.js' | asset_url }}"
    type="module"
  ></script>

  <shipping-eta-selector
    class="shipping-eta spacing-style"
    style="
      {% render 'spacing-style', settings: block_settings %}
      --shipping-eta-background: {{ block_settings.background_color | default: 'rgb(var(--color-foreground-rgb) / 0.04)' }};
      --shipping-eta-border-color: {{ block_settings.border_color | default: 'rgb(var(--color-foreground-rgb) / 0.14)' }};
      --shipping-eta-border-radius: {{ block_settings.border_radius | default: 8 }}px;
    "
    {{ block.shopify_attributes }}
  >
    <div class="shipping-eta__destination-control">
      <p class="shipping-eta__destination-label">{{ block_settings.destination_label | escape }}</p>

      <details class="shipping-eta__destination-dropdown" data-shipping-eta-dropdown>
        <summary
          class="shipping-eta__destination-trigger"
          aria-label="{{ block_settings.destination_label | escape }}"
        >
          {%- if is_eta_list -%}
            {%- for eta in eta_value -%}
              {%- if forloop.first -%}
                {% render 'shipping-eta-entry', eta: eta, settings: block_settings, mode: 'selected', selected: true %}
              {%- endif -%}
            {%- endfor -%}
          {%- else -%}
            {% render 'shipping-eta-entry', eta: eta_value, settings: block_settings, mode: 'selected', selected: true %}
          {%- endif -%}
          <span class="shipping-eta__chevron" aria-hidden="true">
            {{- 'icon-caret.svg' | inline_asset_content -}}
          </span>
        </summary>

        {%- if is_eta_list -%}
          <div class="shipping-eta__destination-options" role="listbox">
            {%- for eta in eta_value -%}
              {% render 'shipping-eta-entry',
                eta: eta,
                settings: block_settings,
                mode: 'option',
                index: forloop.index0,
                selected: forloop.first
              %}
            {%- endfor -%}
          </div>
        {%- endif -%}
      </details>
    </div>

    <div class="shipping-eta__panels">
      {%- if is_eta_list -%}
        {%- for eta in eta_value -%}
          {% render 'shipping-eta-entry',
            eta: eta,
            settings: block_settings,
            mode: 'panel',
            index: forloop.index0,
            selected: forloop.first
          %}
        {%- endfor -%}
      {%- else -%}
        {% render 'shipping-eta-entry', eta: eta_value, settings: block_settings, mode: 'panel', index: 0, selected: true %}
      {%- endif -%}
    </div>
  </shipping-eta-selector>
{%- endif -%}

<script>
  if (!customElements.get('shipping-eta-selector')) {
    customElements.define(
      'shipping-eta-selector',
      class ShippingEtaSelector extends HTMLElement {
        connectedCallback() {
          this.dropdown = this.querySelector('[data-shipping-eta-dropdown]');
          this.selectedFlag = this.querySelector('[data-shipping-eta-selected-flag]');
          this.selectedLabel = this.querySelector('[data-shipping-eta-selected-label]');
          this.options = Array.from(this.querySelectorAll('[data-shipping-eta-option]'));
          this.panels = Array.from(this.querySelectorAll('[data-shipping-eta-panel]'));

          this.options.forEach((option) => {
            option.addEventListener('click', () => this.selectOption(option));
          });
        }

        selectOption(option) {
          const selectedIndex = option.dataset.index;
          const optionFlag = option.querySelector('[data-shipping-eta-option-flag]');
          const optionLabel = option.querySelector('[data-shipping-eta-option-label]');

          if (this.selectedFlag && optionFlag) this.selectedFlag.innerHTML = optionFlag.innerHTML;
          if (this.selectedLabel && optionLabel) this.selectedLabel.textContent = optionLabel.textContent;

          this.options.forEach((item) => {
            item.setAttribute('aria-selected', item === option ? 'true' : 'false');
          });

          this.panels.forEach((panel) => {
            panel.hidden = panel.dataset.index !== selectedIndex;
          });

          if (this.dropdown) this.dropdown.open = false;
        }
      }
    );
  }
</script>

{% stylesheet %}
  .shipping-eta {
    background: var(--shipping-eta-background);
    border: 1px solid var(--shipping-eta-border-color);
    border-radius: var(--shipping-eta-border-radius);
    color: rgb(var(--color-foreground-rgb));
    display: grid;
    gap: var(--gap-md);
    justify-self: stretch;
    min-width: 100%;
    padding: var(--padding-md);
    width: 100%;
  }

  .shipping-eta__destination-control {
    align-items: center;
    display: flex;
    flex-wrap: wrap;
    gap: var(--gap-3xs);
  }

  .shipping-eta__destination-label {
    font-size: var(--font-paragraph--size);
    font-weight: 400;
    line-height: var(--font-paragraph--line-height);
    margin: 0;
  }

  .shipping-eta__destination-dropdown {
    position: relative;
  }

  .shipping-eta__destination-trigger {
    align-items: center;
    border: 0;
    cursor: pointer;
    display: inline-grid;
    font-weight: var(--font-weight-semibold);
    gap: var(--gap-3xs);
    grid-template-columns: auto auto;
    list-style: none;
    min-height: auto;
    padding: 0;
  }

  .shipping-eta__destination-trigger::-webkit-details-marker {
    display: none;
  }

  .shipping-eta__destination-trigger:focus-visible {
    outline: var(--focus-outline-width) solid rgb(var(--color-foreground-rgb) / var(--opacity-35-55));
    outline-offset: var(--focus-outline-offset);
  }

  .shipping-eta__chevron {
    display: inline-flex;
    height: 10px;
    transition: transform var(--animation-speed) var(--animation-easing);
    width: 10px;
  }

  .shipping-eta__destination-trigger .shipping-eta__flag {
    display: none;
  }

  .shipping-eta__destination-dropdown[open] .shipping-eta__chevron {
    transform: rotate(180deg);
  }

  .shipping-eta__destination-options {
    background: rgb(var(--color-background-rgb));
    border: 1px solid rgb(var(--color-foreground-rgb) / 0.16);
    border-radius: var(--style-border-radius-inputs, 8px);
    box-shadow: var(--shadow-popover);
    display: grid;
    inset-block-start: calc(100% + var(--gap-3xs));
    inset-inline: 0;
    max-height: 240px;
    overflow: auto;
    padding: var(--padding-2xs);
    position: absolute;
    z-index: var(--layer-temporary);
  }

  .shipping-eta__destination-option {
    align-items: center;
    background: transparent;
    border: 0;
    border-radius: calc(var(--style-border-radius-inputs, 8px) / 2);
    color: currentColor;
    cursor: pointer;
    display: grid;
    font: inherit;
    gap: var(--gap-xs);
    grid-template-columns: auto 1fr;
    padding: var(--padding-xs);
    text-align: left;
  }

  .shipping-eta__destination-option:hover,
  .shipping-eta__destination-option[aria-selected='true'] {
    background: rgb(var(--color-foreground-rgb) / 0.06);
  }

  .shipping-eta__flag {
    align-items: center;
    background: rgb(var(--color-foreground-rgb) / 0.06);
    border-radius: 50%;
    display: inline-flex;
    height: 28px;
    justify-content: center;
    overflow: hidden;
    width: 28px;
  }

  .shipping-eta__flag:empty::before {
    color: rgb(var(--color-foreground-rgb) / var(--opacity-subdued-text));
    content: '-';
    font-size: var(--font-size--xs);
  }

  .shipping-eta__flag-image {
    display: block;
    height: 100%;
    object-fit: cover;
    width: 100%;
  }

  .shipping-eta__panels {
    display: grid;
  }

  .shipping-eta__panel {
    display: grid;
    gap: var(--gap-md);
  }

  .shipping-eta__panel[hidden] {
    display: none;
  }

  .shipping-eta__lead {
    margin: 0;
  }

  .shipping-eta__lead {
    font-size: var(--font-paragraph-small--size);
    line-height: var(--font-paragraph--line-height);
  }

  .shipping-eta__methods {
    display: grid;
    gap: var(--gap-xs);
    grid-template-columns: repeat(2, minmax(0, 1fr));
  }

  .shipping-eta__method-dialog {
    display: block;
    min-width: 0;
  }

  .shipping-eta__method-dialog:only-child {
    grid-column: 1 / -1;
  }

  .shipping-eta__method-card {
    align-items: center;
    background: rgb(var(--color-foreground-rgb) / 0.035);
    border: 1px solid rgb(var(--color-foreground-rgb) / 0.06);
    border-radius: 8px;
    color: currentColor;
    cursor: pointer;
    display: flex;
    font: inherit;
    gap: var(--gap-xs);
    min-height: 42px;
    padding: var(--padding-xs) var(--padding-sm);
    text-align: left;
    width: 100%;
  }

  .shipping-eta__method-card:hover {
    background: rgb(var(--color-foreground-rgb) / 0.06);
  }

  .shipping-eta__method-card:focus-visible {
    outline: var(--focus-outline-width) solid rgb(var(--color-foreground-rgb) / var(--opacity-35-55));
    outline-offset: var(--focus-outline-offset);
  }

  .shipping-eta__method-icon {
    display: inline-flex;
    flex: 0 0 auto;
    height: 18px;
    width: 18px;
  }

  .shipping-eta__method-copy {
    display: block;
    min-width: 0;
  }

  .shipping-eta__method-copy strong,
  .shipping-eta__method-copy span {
    display: inline;
    font-size: var(--font-paragraph-small--size);
    line-height: var(--font-paragraph--line-height);
  }

  .shipping-eta__dialog {
    background: var(--color-background);
    border: var(--style-border-popover);
    border-radius: min(var(--style-border-radius-popover), 10px);
    box-shadow: var(--shadow-popover);
    max-height: min(var(--modal-max-height), calc(100dvh - var(--padding-lg)));
    max-width: min(38rem, calc(100vw - var(--padding-lg)));
    padding: var(--padding-lg);
    width: 100%;
  }

  .shipping-eta__dialog[open] {
    animation: modalSlideInTop var(--animation-speed) var(--animation-easing) forwards;
  }

  .shipping-eta__dialog.dialog-closing {
    animation: modalSlideOutTop var(--animation-speed) var(--animation-easing) forwards;
  }

  .shipping-eta__dialog-close {
    opacity: 0.88;
    right: var(--margin-2xs);
    top: var(--margin-2xs);
  }

  .shipping-eta__dialog-inner {
    display: grid;
    gap: var(--gap-md);
  }

  .shipping-eta__dialog-heading {
    align-items: center;
    display: flex;
    font-size: var(--font-h5--size);
    gap: var(--gap-2xs);
    line-height: var(--font-h5--line-height);
    margin: 0;
    padding-inline-end: var(--padding-xl);
  }

  .shipping-eta__method-tabs {
    align-items: center;
    background: rgb(var(--color-foreground-rgb) / 0.06);
    border-radius: 999px;
    display: inline-flex;
    justify-self: center;
    padding: 2px;
  }

  .shipping-eta__method-tab {
    border-radius: 999px;
    font-size: var(--font-paragraph-small--size);
    line-height: 1;
    padding: var(--padding-xs) var(--padding-md);
  }

  .shipping-eta__method-tab--active {
    background: var(--color-background);
    box-shadow: 0 1px 3px rgb(var(--color-foreground-rgb) / 0.12);
    font-weight: var(--font-weight-semibold);
  }

  .shipping-eta__dialog-method {
    font-size: var(--font-paragraph--size);
    font-weight: var(--font-weight-semibold);
    margin: 0;
  }

  .shipping-eta__dialog-rows {
    display: grid;
    margin: 0;
  }

  .shipping-eta__dialog-row {
    border-block-end: 1px solid rgb(var(--color-foreground-rgb) / 0.1);
    display: grid;
    gap: var(--gap-md);
    grid-template-columns: minmax(0, 1fr) auto;
    padding-block: var(--padding-xs);
  }

  .shipping-eta__dialog-row dt,
  .shipping-eta__dialog-row dd {
    font-size: var(--font-paragraph-small--size);
    line-height: var(--font-paragraph--line-height);
    margin: 0;
  }

  .shipping-eta__dialog-row dd {
    font-weight: var(--font-weight-semibold);
    text-align: right;
  }

  .shipping-eta__dialog-note {
    font-size: var(--font-paragraph-small--size);
    line-height: var(--font-paragraph--line-height);
  }

  .shipping-eta__dialog-note > * {
    margin-block: 0 var(--margin-xs);
  }

  .shipping-eta__dialog-note > *:last-child {
    margin-block-end: 0;
  }

  .shipping-eta svg {
    display: block;
    fill: none;
    height: 100%;
    stroke: currentColor;
    stroke-linecap: round;
    stroke-linejoin: round;
    stroke-width: 2;
    width: 100%;
  }

  @media screen and (max-width: 489px) {
    .shipping-eta__methods {
      grid-template-columns: 1fr;
    }

    .shipping-eta__dialog {
      border-end-end-radius: 0;
      border-end-start-radius: 0;
      margin-block-end: 0;
      max-width: 100vw;
    }

    .shipping-eta__method-tab {
      padding-inline: var(--padding-sm);
    }
  }
{% endstylesheet %}

{% schema %}
{
