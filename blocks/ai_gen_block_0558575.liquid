{% doc %}
  @prompt
    tạo một block cho production tab (collapsable), Thêm cho tôi 3 icon bên cạnh các header
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-product-tab-{{ ai_gen_id }} {
    display: block;
    width: {{ block.settings.desktop_width_percent }}%;
    max-width: 100%;
    margin: 0 auto;
  }

  .ai-product-tab__item-{{ ai_gen_id }} {
    border: {{ block.settings.border_width }}px solid {{ block.settings.border_color }};
    border-radius: {{ block.settings.border_radius }}px;
    margin-bottom: {{ block.settings.spacing }}px;
    overflow: hidden;
    background-color: {{ block.settings.background_color }};
  }

  .ai-product-tab__header-{{ ai_gen_id }} {
    width: 100%;
    padding: {{ block.settings.padding }}px;
    background-color: {{ block.settings.header_background_color }};
    border: none;
    text-align: left;
    cursor: pointer;
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 12px;
    transition: background-color 0.3s ease;
  }

  .ai-product-tab__header-{{ ai_gen_id }}:hover {
    background-color: {{ block.settings.header_hover_color }};
  }

  .ai-product-tab__header-left-{{ ai_gen_id }} {
    display: flex;
    align-items: center;
    gap: 12px;
    flex: 1;
  }

  .ai-product-tab__header-icon-{{ ai_gen_id }} {
    width: {{ block.settings.header_icon_size }}px;
    height: {{ block.settings.header_icon_size }}px;
    color: {{ block.settings.header_icon_color }};
    flex-shrink: 0;
  }

  .ai-product-tab__title-{{ ai_gen_id }} {
    margin: 0;
    font-size: {{ block.settings.title_size }}px;
    color: {{ block.settings.title_color }};
    font-weight: 600;
  }

  .ai-product-tab__icon-{{ ai_gen_id }} {
    width: 20px;
    height: 20px;
    transition: transform 0.3s ease;
    color: {{ block.settings.icon_color }};
    flex-shrink: 0;
  }

  .ai-product-tab__icon-{{ ai_gen_id }}.active {
    transform: rotate(180deg);
  }

  .ai-product-tab__content-{{ ai_gen_id }} {
    max-height: 0;
    overflow: hidden;
    transition: max-height 0.3s ease;
  }

  .ai-product-tab__content-{{ ai_gen_id }}.active {
    max-height: 1000px;
  }

  .ai-product-tab__content-inner-{{ ai_gen_id }} {
    padding: {{ block.settings.padding }}px;
    color: {{ block.settings.content_color }};
    font-size: {{ block.settings.content_size }}px;
    line-height: 1.6;
  }

  .ai-product-tab__content-inner-{{ ai_gen_id }} p {
    margin: 0 0 12px;
  }

  .ai-product-tab__content-inner-{{ ai_gen_id }} p:last-child {
    margin-bottom: 0;
  }

  .ai-product-tab__empty-state-{{ ai_gen_id }} {
    padding: {{ block.settings.padding }}px;
    text-align: center;
    color: #999;
    font-style: italic;
  }
{% endstyle %}

