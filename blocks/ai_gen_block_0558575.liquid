<script>
  (function() {
    class ProductTabs{{ ai_gen_id }} extends HTMLElement {
      constructor() {
        super();
      }

      connectedCallback() {
        this.headers = this.querySelectorAll('.ai-product-tab__header-{{ ai_gen_id }}');
        this.setupEventListeners();
      }

      setupEventListeners() {
        this.headers.forEach((header) => {
          header.addEventListener('click', () => {
            const content = header.nextElementSibling;
            const icon = header.querySelector('.ai-product-tab__icon-{{ ai_gen_id }}');
            const isActive = content.classList.contains('active');

            content.classList.toggle('active');
            icon.classList.toggle('active');
            header.setAttribute('aria-expanded', !isActive);
          });
        });
      }
    }

    customElements.define('product-tabs-{{ ai_gen_id }}', ProductTabs{{ ai_gen_id }});
  })();
</script>

