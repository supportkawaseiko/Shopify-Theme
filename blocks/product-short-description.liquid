{% liquid
  assign product_namespace = block.settings.product_bullets_namespace | default: 'custom' | strip
  assign product_key = block.settings.product_bullets_key | default: 'short_description_bullets' | strip
  assign product_bullets = closest.product.metafields[product_namespace][product_key]
  capture items
    if product_bullets.type == 'multi_line_text_field'
      assign lines = product_bullets.value | newline_to_br | split: '<br />'
      for line in lines
        assign text = line | strip
        if text != blank
          echo '<li>'
          echo text | escape
          echo '</li>'
        endif
      endfor
    endif
  endcapture
%}
{% if items != blank or request.design_mode %}
  <section class="product-short-description" {{ block.shopify_attributes }}>
    {% if block.settings.heading != blank %}
      <h2 class="product-short-description__heading">{{ block.settings.heading | escape }}</h2>
    {% endif %}
    {% if items != blank %}
      <ul class="product-short-description__list">{{ items }}</ul>
    {% else %}
      <p class="product-short-description__placeholder">
        Add this product's short description in {{ product_namespace | escape }}.{{ product_key | escape }}
        (Multi-line text), one bullet per line.
        This empty block is hidden on the storefront.
      </p>
    {% endif %}
  </section>
{% endif %}

{% stylesheet %}
  .product-short-description {
    width: 100%;
    min-width: 0;
    color: var(--color-foreground);
    font-size: 14px;
    line-height: 1.6;
    overflow-wrap: anywhere;
  }

  .product-short-description__heading {
    margin: 0 0 12px;
    font-family: var(--font-body--family);
    font-size: 18px;
    font-weight: 600;
    line-height: 1.4;
  }

  .product-short-description__list {
    margin: 0;
    padding-inline-start: 20px;
    list-style: disc outside;
  }

  .product-short-description__list li + li { margin-block-start: 8px; }
  .product-short-description__placeholder { margin: 0; opacity: .75; }
{% endstylesheet %}

{% schema %}
{
  "name": "Short description",
  "tag": null,
  "settings": [
    {"type":"text","id":"heading","label":"Heading","default":"About this item"},
    {"type":"header","content":"Product-specific bullets"},
    {"type":"text","id":"product_bullets_namespace","label":"Product bullets namespace","default":"custom"},
    {"type":"text","id":"product_bullets_key","label":"Product bullets metafield key","default":"short_description_bullets","info":"A product metafield of type Multi-line text. Enter one bullet per line directly on each product."}
  ],
  "presets": [{"name":"Short description","category":"t:categories.product"}]
}
{% endschema %}
