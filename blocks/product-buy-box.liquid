<aside class="product-buy-box" aria-label="Purchase options" {{ block.shopify_attributes }}>
  {% if block.settings.show_membership and block.settings.member_link != blank %}
    <div class="product-buy-box__membership">
      {% if block.settings.free_shipping_active %}
        <p class="product-buy-box__member-benefit">Get <strong>{{ block.settings.member_shipping_benefit | default: 'Fast, Free Shipping' | escape }}</strong> with <a href="{{ block.settings.member_link }}">{{ block.settings.member_heading | escape }}</a></p>
        <p>Free shipping on every US order after signing up.</p>
      {% else %}
        <strong>{{ block.settings.member_heading | escape }}</strong>
        <p>{{ block.settings.member_text | escape }}</p>
        <a href="{{ block.settings.member_link }}">{{ block.settings.member_link_label | escape }} <span aria-hidden="true">→</span></a>
      {% endif %}
    </div>
  {% endif %}
  <product-price class="product-buy-box__price" data-block-id="{{ block.id }}" data-product-id="{{ closest.product.id }}">
    {% render 'price', product_resource: closest.product, show_sale_price_first: true %}
  </product-price>
  {% render 'buy-box-delivery-dates', product: closest.product, buy_box: block %}
  {% assign returns_url = block.settings.returns_link | default: pages['refund-replacement'].url | default: shop.refund_policy.url %}
  <div class="product-buy-box__blocks">{% content_for 'blocks' %}</div>
  <dl class="product-buy-box__order-details">
    <div><dt>Sold by</dt><dd>{{ shop.name | escape }}</dd></div>
    {% if block.settings.show_returns and returns_url != blank %}
      <div><dt>Returns</dt><dd><a href="{{ returns_url }}">{{ block.settings.returns_text | escape }}</a></dd></div>
    {% endif %}
    <div><dt>Payment</dt><dd>Secure checkout</dd></div>
  </dl>
  {% if block.settings.support_link != blank %}<a class="product-buy-box__support" href="{{ block.settings.support_link }}">{{ block.settings.support_label | escape }}</a>{% endif %}
</aside>
{% stylesheet %}
  .product-buy-box { display: block; width: 100%; min-width: 0; padding: 20px; border: 1px solid rgb(var(--color-foreground-rgb) / .18); border-radius: 12px; background: var(--color-background); }
  .product-buy-box__price { display: block; margin-bottom: 20px; }
  .product-buy-box__price .price { font-size: 24px; }
  .product-buy-box__blocks { display: flex; flex-direction: column; gap: 18px; }
  .product-buy-box .buy-buttons-block { width: 100%; }
  .product-buy-box .trust-signals { margin: 0; padding: 0; background: transparent; gap: 10px; }
  .product-buy-box .trust-signals__item { font-size: 12px; gap: 8px; }
  .product-buy-box .trust-signals__icon { width: 20px; height: 20px; flex-basis: 20px; }
  .product-buy-box .product-form-buttons { --flex-wrap: wrap; }
  .product-buy-box__delivery, .product-buy-box__membership { margin-top: 20px; padding-top: 18px; border-top: 1px solid rgb(var(--color-foreground-rgb) / .12); font-size: 14px; line-height: 1.5; }
  .product-buy-box p { margin: 6px 0; }
  .product-buy-box a { color: inherit; text-underline-offset: 3px; }
  .product-buy-box__membership { margin: 0 0 20px; padding: 0 0 16px; border: 0; border-bottom: 1px solid rgb(var(--color-foreground-rgb) / .12); }
  .product-buy-box__support { display: inline-block; margin-top: 18px; font-size: 13px; }
  .product-buy-box__delivery--estimate { margin: 0 0 20px; padding: 0; border: 0; }
  .product-buy-box__eta { font-weight: 400; }
  .product-buy-box .product-buy-box__fine-print { font-size: 12px; opacity: .8; }
  .product-buy-box__order-details { display: grid; gap: 10px; margin: 20px 0 0; padding-top: 18px; border-top: 1px solid rgb(var(--color-foreground-rgb) / .12); font-size: 13px; line-height: 1.5; }
  .product-buy-box__order-details > div { display: grid; grid-template-columns: 64px minmax(0, 1fr); gap: 12px; }
  .product-buy-box__order-details dt { opacity: .75; }
  .product-buy-box__order-details dd { margin: 0; }
  @media(min-width:1200px) {
    .product-information .product-information__grid:has(.product-details--buy-box) { grid-column: 2 !important; grid-template-columns: minmax(0, .9fr) minmax(0, 1.1fr) !important; }
    .product-information .product-information__grid:has(.product-details--buy-box) .product-information__media { grid-column: 1 / 2 !important; padding-inline: 0 24px; }
    .product-information .product-information__grid .product-details--buy-box { grid-column: 2 / 3 !important; padding: 0; position: static; }
    .product-details--buy-box > .group-block > .group-block-content { display: grid; grid-template-columns: minmax(0, 1fr) minmax(260px, .8fr); gap: 24px; align-items: start; }
    .product-details--buy-box > .group-block > .group-block-content > .view-product-title { display: none; }
    .product-details--buy-box .product-buy-box { position: sticky; top: calc(var(--header-height, 0px) + 16px); }
  }
{% endstylesheet %}
{% schema %}
{
  "name": "Product buy box", "tag": null,
  "blocks": [{"type":"buy-buttons"},{"type":"shipping-eta"},{"type":"trust-signals"},{"type":"teeinblue-buy-box-actions"},{"type":"@app"}],
  "settings": [
    {"type":"text","id":"delivery_heading","label":"Delivery heading","default":"Delivery information"},
    {"type":"text","id":"delivery_text","label":"Delivery note","default":"Review production and delivery estimates before ordering. Shipping is calculated at checkout."},
    {"type":"url","id":"delivery_link","label":"Delivery link"},
    {"type":"text","id":"delivery_link_label","label":"Delivery link label","default":"View delivery details"},
    {"type":"text","id":"eta_us_ca_au","label":"Estimated delivery - US, Canada, Australia","default":"4–12 business days"},
    {"type":"text","id":"eta_uk","label":"Estimated delivery - United Kingdom","default":"10–17 business days"},
    {"type":"range","id":"eta_days_us_ca_au","label":"Delivery estimate in business days - US, Canada, Australia","min":1,"max":60,"step":1,"default":12,"info":"Includes processing. Skips weekends; public holidays are not included in this calculation."},
    {"type":"range","id":"eta_days_uk","label":"Delivery estimate in business days - United Kingdom","min":1,"max":60,"step":1,"default":17,"info":"Includes processing. Skips weekends; public holidays are not included in this calculation."},
    {"type":"range","id":"eta_min_us_ca_au","label":"Earliest delivery in business days - US, Canada, Australia","min":1,"max":60,"step":1,"default":4},
    {"type":"range","id":"eta_min_uk","label":"Earliest delivery in business days - United Kingdom","min":1,"max":60,"step":1,"default":10},
    {"type":"text","id":"eta_other","label":"Estimated delivery - other destinations","default":"See delivery details for your destination"},
    {"type":"text","id":"eta_note","label":"Delivery estimate note","default":"Includes 1–3 business days of processing. Delivery times are estimates, not guarantees."},
    {"type":"checkbox","id":"show_returns","label":"Show returns information","default":true},
    {"type":"text","id":"returns_text","label":"Returns text","default":"30-day returns on eligible items"},
    {"type":"url","id":"returns_link","label":"Returns policy link"},
    {"type":"checkbox","id":"show_membership","label":"Show membership information","default":true},
    {"type":"text","id":"member_heading","label":"Membership heading","default":"Customversal Club"},
    {"type":"text","id":"member_text","label":"Membership text","default":"Discover member-only offers and benefits."},
    {"type":"url","id":"member_link","label":"Membership link"},
    {"type":"text","id":"member_link_label","label":"Membership link label","default":"Explore the Club"},
    {"type":"text","id":"member_shipping_benefit","label":"Member shipping benefit","default":"Fast, Free Shipping","info":"Only promise fast shipping if your confirmed delivery service supports it. Use Free Shipping otherwise."},
    {"type":"checkbox","id":"free_shipping_active","label":"Show free US shipping for members","info":"Enable only after Club registration and the member free-shipping discount are active at checkout.","default":false},
    {"type":"url","id":"support_link","label":"Support link"},
    {"type":"text","id":"support_label","label":"Support link label","default":"Questions about your order?"}
  ],
  "presets": [{"name":"Product buy box"}]
}
{% endschema %}
