{% comment %}
  Hippolord About Story
  Editorial storytelling page section for Shopify Horizon
{% endcomment %}

<section
  class="hippo-about"
  style="
    --about-page-bg: {{ section.settings.page_background }};
    --about-page-text: {{ section.settings.page_text }};
    --about-page-muted: {{ section.settings.page_muted }};
    --about-page-accent: {{ section.settings.page_accent }};
    --about-max-width: {{ section.settings.max_width }}px;
    --about-section-gap: {{ section.settings.section_gap }}px;
  "
>
  <div
    class="hippo-about__hero"
    style="
      --hero-bg: {{ section.settings.hero_background }};
      --hero-text: {{ section.settings.hero_text_color }};
      --hero-overlay: {{ section.settings.hero_overlay | divided_by: 100.0 }};
      --hero-height: {{ section.settings.hero_height }}vh;
      --hero-content-width: {{ section.settings.hero_content_width }}px;
      --hero-x: {{ section.settings.hero_horizontal }};
      --hero-y: {{ section.settings.hero_vertical }};
    "
  >
    {% if section.settings.hero_image != blank %}
      <div class="hippo-about__hero-media">
        {{
          section.settings.hero_image
          | image_url: width: 2400
          | image_tag:
            loading: 'eager',
            preload: true,
            fetchpriority: 'high',
            widths: '640, 960, 1280, 1600, 2000, 2400',
            sizes: '100vw',
            alt: section.settings.hero_image_alt
        }}
      </div>
      <div class="hippo-about__hero-overlay"></div>
    {% endif %}

    <div class="hippo-about__hero-inner">
      <div class="hippo-about__hero-content">
        {% if section.settings.hero_eyebrow != blank %}
          <div class="hippo-about__eyebrow">
            {{ section.settings.hero_eyebrow }}
          </div>
        {% endif %}

        {% if section.settings.hero_heading != blank %}
          <h1 class="hippo-about__hero-heading">
            {{ section.settings.hero_heading }}
          </h1>
        {% endif %}

        {% if section.settings.hero_subheading != blank %}
          <div class="hippo-about__hero-subheading">
            {{ section.settings.hero_subheading }}
          </div>
        {% endif %}

        {% if section.settings.hero_intro != blank %}
          <div class="hippo-about__hero-intro rte">
            {{ section.settings.hero_intro }}
          </div>
        {% endif %}

        {% if section.settings.hero_button_label != blank and section.settings.hero_button_link != blank %}
          <a class="hippo-about__button hippo-about__button--light" href="{{ section.settings.hero_button_link }}">
            {{ section.settings.hero_button_label }}
            <span aria-hidden="true">→</span>
          </a>
        {% endif %}
      </div>
    </div>
  </div>

  <div class="hippo-about__story">
    {% for block in section.blocks %}
      {% case block.type %}

        {% when 'story' %}
          <article
            class="hippo-about__scene hippo-about__scene--{{ block.settings.layout }}"
            style="
              --scene-bg: {{ block.settings.background }};
              --scene-text: {{ block.settings.text_color }};
              --scene-muted: {{ block.settings.muted_color }};
              --scene-accent: {{ block.settings.accent_color }};
              --scene-pad-top: {{ block.settings.padding_top }}px;
              --scene-pad-bottom: {{ block.settings.padding_bottom }}px;
              --scene-radius: {{ block.settings.image_radius }}px;
              --scene-image-ratio: {{ block.settings.image_ratio }};
            "
            {{ block.shopify_attributes }}
          >
            <div class="hippo-about__scene-inner">
              {% if block.settings.image != blank %}
                <div class="hippo-about__scene-media">
                  {{
                    block.settings.image
                    | image_url: width: 1800
                    | image_tag:
                      loading: 'lazy',
                      widths: '480, 720, 960, 1200, 1500, 1800',
                      sizes: '(max-width: 749px) 100vw, 50vw',
                      alt: block.settings.image_alt
                  }}
                  {% if block.settings.image_caption != blank %}
                    <div class="hippo-about__caption">{{ block.settings.image_caption }}</div>
                  {% endif %}
                </div>
              {% endif %}

              <div class="hippo-about__scene-content">
                {% if block.settings.eyebrow != blank %}
                  <div class="hippo-about__eyebrow">
                    {{ block.settings.eyebrow }}
                  </div>
                {% endif %}

                {% if block.settings.heading != blank %}
                  <h2 class="hippo-about__scene-heading">
                    {{ block.settings.heading }}
                  </h2>
                {% endif %}

                {% if block.settings.body != blank %}
                  <div class="hippo-about__scene-body rte">
                    {{ block.settings.body }}
                  </div>
                {% endif %}

                {% if block.settings.quote != blank %}
                  <blockquote class="hippo-about__quote">
                    {{ block.settings.quote }}
                  </blockquote>
                {% endif %}

                {% if block.settings.button_label != blank and block.settings.button_link != blank %}
                  <a class="hippo-about__text-link" href="{{ block.settings.button_link }}">
                    {{ block.settings.button_label }}
                    <span aria-hidden="true">→</span>
                  </a>
                {% endif %}
              </div>
            </div>
          </article>

        {% when 'statement' %}
          <section
            class="hippo-about__statement hippo-about__statement--{{ block.settings.alignment }}"
            style="
              --statement-bg: {{ block.settings.background }};
              --statement-text: {{ block.settings.text_color }};
              --statement-muted: {{ block.settings.muted_color }};
              --statement-accent: {{ block.settings.accent_color }};
              --statement-pad: {{ block.settings.padding }}px;
              --statement-size: {{ block.settings.heading_size }}px;
            "
            {{ block.shopify_attributes }}
          >
            <div class="hippo-about__statement-inner">
              {% if block.settings.eyebrow != blank %}
                <div class="hippo-about__eyebrow">
                  {{ block.settings.eyebrow }}
                </div>
              {% endif %}

              {% if block.settings.heading != blank %}
                <h2 class="hippo-about__statement-heading">
                  {{ block.settings.heading }}
                </h2>
              {% endif %}

              {% if block.settings.body != blank %}
                <div class="hippo-about__statement-body rte">
                  {{ block.settings.body }}
                </div>
              {% endif %}
            </div>
          </section>

        {% when 'cta' %}
          <section
            class="hippo-about__cta"
            style="
              --cta-bg: {{ block.settings.background }};
              --cta-text: {{ block.settings.text_color }};
              --cta-muted: {{ block.settings.muted_color }};
              --cta-accent: {{ block.settings.accent_color }};
              --cta-pad: {{ block.settings.padding }}px;
            "
            {{ block.shopify_attributes }}
          >
            <div class="hippo-about__cta-inner">
              {% if block.settings.eyebrow != blank %}
                <div class="hippo-about__eyebrow">
                  {{ block.settings.eyebrow }}
                </div>
              {% endif %}

              {% if block.settings.heading != blank %}
                <h2 class="hippo-about__cta-heading">
                  {{ block.settings.heading }}
                </h2>
              {% endif %}

              {% if block.settings.body != blank %}
                <div class="hippo-about__cta-body rte">
                  {{ block.settings.body }}
                </div>
              {% endif %}

              <div class="hippo-about__cta-actions">
                {% if block.settings.primary_label != blank and block.settings.primary_link != blank %}
                  <a class="hippo-about__button hippo-about__button--primary" href="{{ block.settings.primary_link }}">
                    {{ block.settings.primary_label }}
                    <span aria-hidden="true">→</span>
                  </a>
                {% endif %}

                {% if block.settings.secondary_label != blank and block.settings.secondary_link != blank %}
                  <a class="hippo-about__button hippo-about__button--secondary" href="{{ block.settings.secondary_link }}">
                    {{ block.settings.secondary_label }}
                  </a>
                {% endif %}
              </div>
            </div>
          </section>

      {% endcase %}
    {% endfor %}
  </div>
</section>

{% style %}
#shopify-section-{{ section.id }} .hippo-about {
  width: 100%;
  overflow: hidden;
  background: var(--about-page-bg);
  color: var(--about-page-text);
  font-family: var(--font-body--family);
}

#shopify-section-{{ section.id }} .hippo-about *,
#shopify-section-{{ section.id }} .hippo-about *::before,
#shopify-section-{{ section.id }} .hippo-about *::after {
  box-sizing: border-box;
}

#shopify-section-{{ section.id }} .hippo-about .rte p {
  margin: 0 0 1em;
}

#shopify-section-{{ section.id }} .hippo-about .rte p:last-child {
  margin-bottom: 0;
}

/* HERO */
#shopify-section-{{ section.id }} .hippo-about__hero {
  position: relative;
  min-height: clamp(520px, var(--hero-height), 900px);
  display: flex;
  isolation: isolate;
  background: var(--hero-bg);
  color: var(--hero-text);
}

#shopify-section-{{ section.id }} .hippo-about__hero-media,
#shopify-section-{{ section.id }} .hippo-about__hero-overlay {
  position: absolute;
  inset: 0;
}

#shopify-section-{{ section.id }} .hippo-about__hero-media {
  z-index: -2;
}

#shopify-section-{{ section.id }} .hippo-about__hero-media img {
  display: block;
  width: 100%;
  height: 100%;
  object-fit: cover;
}

#shopify-section-{{ section.id }} .hippo-about__hero-overlay {
  z-index: -1;
  background: rgba(43, 35, 37, var(--hero-overlay));
}

#shopify-section-{{ section.id }} .hippo-about__hero-inner {
  width: min(calc(100% - 40px), var(--about-max-width));
  margin: auto;
  min-height: inherit;
  display: flex;
  align-items: var(--hero-y);
  justify-content: var(--hero-x);
  padding: 70px 0;
}

#shopify-section-{{ section.id }} .hippo-about__hero-content {
  width: min(100%, var(--hero-content-width));
}

#shopify-section-{{ section.id }} .hippo-about__eyebrow {
  margin-bottom: 12px;
  font-family: var(--font-subheading--family);
  font-style: var(--font-subheading--style);
  font-weight: var(--font-subheading--weight);
  font-size: 11px;
  line-height: 1.2;
  letter-spacing: .14em;
  text-transform: uppercase;
  color: currentColor;
  opacity: .82;
}

#shopify-section-{{ section.id }} .hippo-about__hero-heading,
#shopify-section-{{ section.id }} .hippo-about__scene-heading,
#shopify-section-{{ section.id }} .hippo-about__statement-heading,
#shopify-section-{{ section.id }} .hippo-about__cta-heading {
  font-family: var(--font-heading--family);
  font-style: var(--font-heading--style);
  font-weight: var(--font-heading--weight);
  letter-spacing: -.04em;
}

#shopify-section-{{ section.id }} .hippo-about__hero-heading {
  max-width: 9.5em;
  margin: 0;
  font-size: clamp(48px, 7vw, 92px);
  line-height: .92;
  text-transform: uppercase;
}

#shopify-section-{{ section.id }} .hippo-about__hero-subheading {
  max-width: 650px;
  margin-top: 22px;
  font-family: var(--font-heading--family);
  font-weight: 700;
  font-size: clamp(22px, 3vw, 34px);
  line-height: 1.05;
}

#shopify-section-{{ section.id }} .hippo-about__hero-intro {
  max-width: 570px;
  margin-top: 20px;
  font-size: 15px;
  line-height: 1.65;
  opacity: .9;
}

/* STORY */
#shopify-section-{{ section.id }} .hippo-about__story {
  display: flex;
  flex-direction: column;
  gap: var(--about-section-gap);
}

#shopify-section-{{ section.id }} .hippo-about__scene {
  padding: var(--scene-pad-top) 0 var(--scene-pad-bottom);
  background: var(--scene-bg);
  color: var(--scene-text);
}

#shopify-section-{{ section.id }} .hippo-about__scene-inner {
  width: min(calc(100% - 40px), var(--about-max-width));
  margin: 0 auto;
  display: grid;
  grid-template-columns: minmax(0, 1.08fr) minmax(320px, .92fr);
  gap: clamp(38px, 6vw, 88px);
  align-items: center;
}

#shopify-section-{{ section.id }} .hippo-about__scene--image_right .hippo-about__scene-media {
  order: 2;
}

#shopify-section-{{ section.id }} .hippo-about__scene--image_right .hippo-about__scene-content {
  order: 1;
}

#shopify-section-{{ section.id }} .hippo-about__scene--text_only .hippo-about__scene-inner {
  display: block;
  width: min(calc(100% - 40px), 860px);
}

#shopify-section-{{ section.id }} .hippo-about__scene--text_only .hippo-about__scene-content {
  max-width: none;
}

#shopify-section-{{ section.id }} .hippo-about__scene-media {
  min-width: 0;
}

#shopify-section-{{ section.id }} .hippo-about__scene-media img {
  display: block;
  width: 100%;
  aspect-ratio: var(--scene-image-ratio);
  object-fit: cover;
  border-radius: var(--scene-radius);
}

#shopify-section-{{ section.id }} .hippo-about__caption {
  margin-top: 10px;
  font-size: 11px;
  line-height: 1.4;
  color: var(--scene-muted);
}

#shopify-section-{{ section.id }} .hippo-about__scene-content {
  max-width: 590px;
}

#shopify-section-{{ section.id }} .hippo-about__scene-content .hippo-about__eyebrow {
  color: var(--scene-accent);
  opacity: 1;
}

#shopify-section-{{ section.id }} .hippo-about__scene-heading {
  margin: 0;
  font-size: clamp(36px, 4.7vw, 64px);
  line-height: .98;
  color: var(--scene-text);
}

#shopify-section-{{ section.id }} .hippo-about__scene-body {
  margin-top: 22px;
  font-size: 16px;
  line-height: 1.7;
  color: var(--scene-muted);
}

#shopify-section-{{ section.id }} .hippo-about__quote {
  margin: 30px 0 0;
  padding: 0 0 0 18px;
  border-left: 3px solid var(--scene-accent);
  font-family: var(--font-heading--family);
  font-weight: 700;
  font-size: clamp(23px, 2.6vw, 34px);
  line-height: 1.08;
  color: var(--scene-text);
}

#shopify-section-{{ section.id }} .hippo-about__text-link {
  display: inline-flex;
  align-items: center;
  gap: 10px;
  margin-top: 26px;
  color: var(--scene-accent);
  font-family: var(--font-heading--family);
  font-weight: 700;
  font-size: 13px;
  text-decoration: none;
}

#shopify-section-{{ section.id }} .hippo-about__text-link span {
  transition: transform .2s ease;
}

@media (hover:hover) and (pointer:fine) {
  #shopify-section-{{ section.id }} .hippo-about__text-link:hover span {
    transform: translateX(4px);
  }
}

/* STATEMENT */
#shopify-section-{{ section.id }} .hippo-about__statement {
  padding: var(--statement-pad) 20px;
  background: var(--statement-bg);
  color: var(--statement-text);
}

#shopify-section-{{ section.id }} .hippo-about__statement-inner {
  width: min(100%, 1100px);
  margin: 0 auto;
}

#shopify-section-{{ section.id }} .hippo-about__statement--center .hippo-about__statement-inner {
  text-align: center;
}

#shopify-section-{{ section.id }} .hippo-about__statement--right .hippo-about__statement-inner {
  text-align: right;
}

#shopify-section-{{ section.id }} .hippo-about__statement .hippo-about__eyebrow {
  color: var(--statement-accent);
  opacity: 1;
}

#shopify-section-{{ section.id }} .hippo-about__statement-heading {
  margin: 0;
  font-size: clamp(42px, 7vw, var(--statement-size));
  line-height: .92;
  text-transform: uppercase;
  color: var(--statement-text);
}

#shopify-section-{{ section.id }} .hippo-about__statement-body {
  max-width: 700px;
  margin-top: 24px;
  font-size: 16px;
  line-height: 1.65;
  color: var(--statement-muted);
}

#shopify-section-{{ section.id }} .hippo-about__statement--center .hippo-about__statement-body {
  margin-left: auto;
  margin-right: auto;
}

#shopify-section-{{ section.id }} .hippo-about__statement--right .hippo-about__statement-body {
  margin-left: auto;
}

/* CTA */
#shopify-section-{{ section.id }} .hippo-about__cta {
  padding: var(--cta-pad) 20px;
  background: var(--cta-bg);
  color: var(--cta-text);
}

#shopify-section-{{ section.id }} .hippo-about__cta-inner {
  width: min(100%, 820px);
  margin: 0 auto;
  text-align: center;
}

#shopify-section-{{ section.id }} .hippo-about__cta .hippo-about__eyebrow {
  color: var(--cta-accent);
  opacity: 1;
}

#shopify-section-{{ section.id }} .hippo-about__cta-heading {
  margin: 0;
  font-size: clamp(42px, 6vw, 76px);
  line-height: .94;
  text-transform: uppercase;
  color: var(--cta-text);
}

#shopify-section-{{ section.id }} .hippo-about__cta-body {
  max-width: 620px;
  margin: 22px auto 0;
  font-size: 16px;
  line-height: 1.65;
  color: var(--cta-muted);
}

#shopify-section-{{ section.id }} .hippo-about__cta-actions {
  display: flex;
  flex-wrap: wrap;
  justify-content: center;
  gap: 12px;
  margin-top: 30px;
}

/* BUTTONS */
#shopify-section-{{ section.id }} .hippo-about__button {
  min-height: 48px;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  gap: 12px;
  padding: 0 22px;
  border-radius: 9px;
  font-family: var(--font-heading--family);
  font-weight: 700;
  font-size: 13px;
  text-decoration: none;
  transition: transform .2s ease, opacity .2s ease;
}

#shopify-section-{{ section.id }} .hippo-about__button--light {
  margin-top: 26px;
  background: #FFF9F6;
  color: #2B2325;
}

#shopify-section-{{ section.id }} .hippo-about__button--primary {
  background: var(--cta-accent);
  color: #FFFFFF;
}

#shopify-section-{{ section.id }} .hippo-about__button--secondary {
  border: 1px solid currentColor;
  color: var(--cta-text);
}

@media (hover:hover) and (pointer:fine) {
  #shopify-section-{{ section.id }} .hippo-about__button:hover {
    transform: translateY(-2px);
  }
}

/* MOBILE */
@media screen and (max-width: 749px) {
  #shopify-section-{{ section.id }} .hippo-about__hero {
    min-height: 620px;
  }

  #shopify-section-{{ section.id }} .hippo-about__hero-inner {
    width: calc(100% - 28px);
    padding: 48px 0;
    align-items: flex-end;
    justify-content: flex-start;
  }

  #shopify-section-{{ section.id }} .hippo-about__hero-heading {
    font-size: 48px;
  }

  #shopify-section-{{ section.id }} .hippo-about__hero-subheading {
    font-size: 23px;
  }

  #shopify-section-{{ section.id }} .hippo-about__scene {
    padding-top: max(48px, calc(var(--scene-pad-top) * .7));
    padding-bottom: max(48px, calc(var(--scene-pad-bottom) * .7));
  }

  #shopify-section-{{ section.id }} .hippo-about__scene-inner {
    width: calc(100% - 28px);
    grid-template-columns: 1fr;
    gap: 30px;
  }

  #shopify-section-{{ section.id }} .hippo-about__scene--image_right .hippo-about__scene-media,
  #shopify-section-{{ section.id }} .hippo-about__scene--image_right .hippo-about__scene-content {
    order: initial;
  }

  #shopify-section-{{ section.id }} .hippo-about__scene-heading {
    font-size: 36px;
  }

  #shopify-section-{{ section.id }} .hippo-about__scene-body,
  #shopify-section-{{ section.id }} .hippo-about__statement-body,
  #shopify-section-{{ section.id }} .hippo-about__cta-body {
    font-size: 14px;
  }

  #shopify-section-{{ section.id }} .hippo-about__statement {
    padding-top: max(56px, calc(var(--statement-pad) * .72));
    padding-bottom: max(56px, calc(var(--statement-pad) * .72));
  }

  #shopify-section-{{ section.id }} .hippo-about__statement-heading {
    font-size: 44px;
  }

  #shopify-section-{{ section.id }} .hippo-about__cta {
    padding-top: max(60px, calc(var(--cta-pad) * .72));
    padding-bottom: max(60px, calc(var(--cta-pad) * .72));
  }

  #shopify-section-{{ section.id }} .hippo-about__cta-heading {
    font-size: 44px;
  }

  #shopify-section-{{ section.id }} .hippo-about__cta-actions {
    flex-direction: column;
  }

  #shopify-section-{{ section.id }} .hippo-about__button {
    width: 100%;
  }
}
{% endstyle %}

{% schema %}
{
  "name": "Hippolord About Story",
  "tag": "section",
  "class": "hippolord-about-story-section",
  "max_blocks": 20,
  "settings": [
    {
      "type": "header",
      "content": "Hero"
    },
    {
      "type": "image_picker",
      "id": "hero_image",
      "label": "Hero image"
    },
    {
      "type": "text",
      "id": "hero_image_alt",
      "label": "Hero image alt text"
    },
    {
      "type": "text",
      "id": "hero_eyebrow",
      "label": "Small heading",
      "default": "ABOUT HIPPOLORD"
    },
    {
      "type": "text",
      "id": "hero_heading",
      "label": "Hero heading",
      "default": "SOME MEMORIES DESERVE MORE."
    },
    {
      "type": "text",
      "id": "hero_subheading",
      "label": "Hero subheading",
      "default": "A small moment can become something you never want to lose."
    },
    {
      "type": "richtext",
      "id": "hero_intro",
      "label": "Hero intro",
      "default": "<p>Hippolord began with Jenny sitting beside her mom, looking through childhood photos and realizing how many once-vivid memories had quietly faded with time.</p>"
    },
    {
      "type": "text",
      "id": "hero_button_label",
      "label": "Hero button label"
    },
    {
      "type": "url",
      "id": "hero_button_link",
      "label": "Hero button link"
    },
    {
      "type": "color",
      "id": "hero_background",
      "label": "Hero background",
      "default": "#6F1E33"
    },
    {
      "type": "color",
      "id": "hero_text_color",
      "label": "Hero text",
      "default": "#FFF9F6"
    },
    {
      "type": "range",
      "id": "hero_overlay",
      "label": "Image overlay",
      "min": 0,
      "max": 80,
      "step": 5,
      "unit": "%",
      "default": 35
    },
    {
      "type": "range",
      "id": "hero_height",
      "label": "Hero height",
      "min": 60,
