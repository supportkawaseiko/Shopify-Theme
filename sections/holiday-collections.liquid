{{ 'holiday-collections.css' | asset_url | stylesheet_tag }}
<script src="{{ 'holiday-collections.js' | asset_url }}" defer></script>
<holiday-collections class="holiday-collections section section--page-width holiday-collections--{{ section.settings.layout }}" data-limit="{{ section.settings.product_limit }}" style="--holiday-accent: {{ section.settings.accent }}; --holiday-surface: {{ section.settings.surface }}; --holiday-columns: {{ section.settings.columns }};">
  <header class="holiday-collections__header">
    <div><h2>{{ section.settings.heading | escape }}</h2>{% if section.settings.description != blank %}<p>{{ section.settings.description | escape }}</p>{% endif %}</div>
    {% unless section.settings.layout == 'showcase' or section.settings.layout == 'tabs' %}
      {% if section.settings.collection != blank %}<a class="holiday-collections__link" href="{{ section.settings.collection.url }}">{{ section.settings.link_label | escape }} <span aria-hidden="true">→</span></a>{% endif %}
    {% endunless %}
  </header>
  {% if section.settings.layout == 'showcase' or section.settings.layout == 'tabs' %}
    <div class="holiday-collections__tabs" aria-label="{{ section.settings.heading | escape }}">
      {% for block in section.blocks %}
        {% assign thumbnail = block.settings.image | default: block.settings.collection.image | default: block.settings.collection.products.first.featured_image %}
        <button type="button" id="HolidayTab-{{ section.id }}-{{ block.id }}" aria-controls="HolidayPanel-{{ section.id }}-{{ block.id }}" data-holiday-tab="{{ block.id }}" {{ block.shopify_attributes }}>
          {% if thumbnail != blank %}{{ thumbnail | image_url: width: 160 | image_tag: widths: '80, 160', sizes: '64px', loading: 'lazy', alt: '' }}{% else %}<span class="holiday-collections__initial" aria-hidden="true">{{ block.settings.label | slice: 0 | escape }}</span>{% endif %}
          <span>{{ block.settings.label | default: block.settings.collection.title | escape }}</span>
        </button>
      {% endfor %}
    </div>
    {% for block in section.blocks %}
      <div id="HolidayPanel-{{ section.id }}-{{ block.id }}" aria-labelledby="HolidayTab-{{ section.id }}-{{ block.id }}" data-holiday-panel="{{ block.id }}" class="holiday-collections__panel">
        {% render 'holiday-collection-content', source: block.settings.collection, tag: block.settings.product_tag, banner: block.settings.banner, banner_link: block.settings.link, banner_label: block.settings.banner_label, settings: section.settings %}
      </div>
    {% endfor %}
  {% else %}
    {% render 'holiday-collection-content', source: section.settings.collection, tag: section.settings.product_tag, banner: section.settings.image, banner_link: section.settings.link, banner_label: section.settings.banner_label, settings: section.settings %}
  {% endif %}
  {% if section.settings.layout == 'row' %}<div class="holiday-collections__arrows" hidden><button type="button" data-holiday-scroll="-1" aria-label="Previous products">←</button><button type="button" data-holiday-scroll="1" aria-label="Next products">→</button></div>{% endif %}
</holiday-collections>
{% schema %}
{
  "name": "Holiday collections", "disabled_on": {"groups": ["header", "footer"]}, "max_blocks": 12,
  "settings": [
    {"type":"text","id":"heading","label":"Heading","default":"Find their perfect gift"},
    {"type":"text","id":"description","label":"Description"},
    {"type":"select","id":"layout","label":"Collection layout","options":[{"value":"grid","label":"Product grid"},{"value":"row","label":"Horizontal product row"},{"value":"showcase","label":"Image tabs + feature banner"},{"value":"tabs","label":"Category image tabs + grid"},{"value":"gallery","label":"Shoppable image gallery"}],"default":"grid"},
    {"type":"header","content":"Grid, row and gallery source"},
    {"type":"collection","id":"collection","label":"Collection"},
    {"type":"text","id":"product_tag","label":"Product tag","info":"Optional exact tag within the selected collection. For tab layouts, set collection and tag inside each block."},
    {"type":"image_picker","id":"image","label":"Feature image"},
    {"type":"url","id":"link","label":"Feature image link"},
    {"type":"text","id":"banner_label","label":"Feature image link label","default":"Explore this collection"},
    {"type":"text","id":"link_label","label":"Collection link label","default":"See all"},
    {"type":"range","id":"product_limit","label":"Products to display","min":2,"max":24,"step":1,"default":12},
    {"type":"range","id":"columns","label":"Desktop columns","min":3,"max":6,"step":1,"default":6},
    {"type":"select","id":"sort_order","label":"Product order","options":[{"value":"default","label":"Collection default"},{"value":"best-selling","label":"Best selling"},{"value":"created-descending","label":"Newest first"}],"default":"default"},
    {"type":"color","id":"accent","label":"Accent color","default":"#88283f"},
    {"type":"color","id":"surface","label":"Feature background","default":"#eee0dc"}
  ],
  "blocks": [{"type":"collection","name":"Collection tab","settings":[
    {"type":"text","id":"label","label":"Tab label","default":"Family"},
    {"type":"collection","id":"collection","label":"Collection"},
    {"type":"text","id":"product_tag","label":"Product tag"},
    {"type":"image_picker","id":"image","label":"Tab thumbnail"},
    {"type":"image_picker","id":"banner","label":"Feature banner","info":"For image tabs + feature banner layout. Defaults to the collection image or first product."},
    {"type":"url","id":"link","label":"Feature banner link override"},
    {"type":"text","id":"banner_label","label":"Feature banner link label","default":"Explore these gifts"}
  ]}],
  "presets": [
    {"name":"Holiday · Product grid","settings":{"layout":"grid","heading":"Best Sellers"}},
    {"name":"Holiday · Product row","settings":{"layout":"row","heading":"For Pet Parents"}},
    {"name":"Holiday · Image tabs + banner","settings":{"layout":"showcase","heading":"Gift By Recipient"},"blocks":[{"type":"collection","settings":{"label":"Family"}},{"type":"collection","settings":{"label":"Friends"}}]},
    {"name":"Holiday · Category tabs","settings":{"layout":"tabs","heading":"Recommended Categories"},"blocks":[{"type":"collection","settings":{"label":"Ornaments"}},{"type":"collection","settings":{"label":"Shirts"}}]},
    {"name":"Holiday · Image gallery","settings":{"layout":"gallery","heading":"You Might Like This"}}
  ]
}
{% endschema %}
