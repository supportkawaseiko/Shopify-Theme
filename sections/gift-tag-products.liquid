{% comment %}Server-rendered results in the requested collection/tag context.{% endcomment %}
<ul data-gift-tag-results>
  {% if current_tags != blank %}
  {% for product in collection.products limit: 8 %}
    <li>{% render 'resource-card', resource: product, resource_type: 'product', image_aspect_ratio: '1', image_hover: true, image_sizes: '(min-width: 750px) 25vw, 50vw' %}</li>
  {% endfor %}
  {% endif %}
</ul>
{% schema %}
{"name":"Gift tag results","settings":[]}
{% endschema %}
