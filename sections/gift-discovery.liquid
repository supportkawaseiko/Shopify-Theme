<section class="section section--page-width cv-discovery cv-discovery--{{ section.settings.layout }}">
  <div class="cv-discovery__heading">
    <h2>{{ section.settings.heading | escape }}</h2>
    {% if section.settings.description != blank %}<p>{{ section.settings.description | escape }}</p>{% endif %}
    {% if section.settings.link != blank %}<a class="cv-pill" href="{{ section.settings.link }}">View all <span aria-hidden="true">→</span></a>{% endif %}
  </div>
  {% if section.settings.layout == 'products' %}
    <ul class="cv-discovery__products list-unstyled">
      {% for product in section.settings.collection.products limit: 8 %}
        <li>{% render 'resource-card', resource: product, resource_type: 'product', image_aspect_ratio: '1', image_hover: true, image_sizes: '(min-width: 750px) 25vw, 50vw' %}</li>
      {% endfor %}
    </ul>
  {% else %}
    <div class="cv-discovery__items">
      {% for block in section.blocks %}
        {% liquid
          assign card_image = block.settings.image | default: block.settings.product.featured_image | default: block.settings.collection.image | default: block.settings.collection.products.first.featured_image
          assign card_link = block.settings.link | default: block.settings.collection.url
        %}
        {% if section.settings.layout == 'confidence' %}
          <article class="cv-confidence" {{ block.shopify_attributes }}>
            <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true">
              {% case block.settings.icon %}
                {% when 'payment' %}<rect x="2" y="5" width="20" height="14" rx="3"/><path d="M2 10h20M6 15h4"/>
                {% when 'delivery' %}<path d="M3 4h12v13H3zM15 9h4l3 4v4h-7M3 9h12"/><circle cx="6" cy="19" r="2"/><circle cx="18" cy="19" r="2"/>
                {% when 'privacy' %}<path d="M12 2 3 6v6c0 5 9 10 9 10s9-5 9-10V6z"/><path d="m8 12 3 3 5-6"/>
                {% else %}<path d="M4 8h16v13H4zM2 5h20v4H2zM12 5v16"/><path d="M12 5C6 5 5 1 8 1s4 4 4 4c0 0 1-4 4-4s2 4-4 4"/>
              {% endcase %}
            </svg>
            <h3>{{ block.settings.title | escape }}</h3><p>{{ block.settings.text | escape }}</p>
            {% if card_link != blank %}<a href="{{ card_link }}">Learn more</a>{% endif %}
          </article>
        {% elsif card_link != blank %}
          <a class="cv-discovery__item{% if section.settings.layout == 'recipients' %} cv-pill{% endif %}" href="{{ card_link }}" {{ block.shopify_attributes }}>
            {% unless section.settings.layout == 'recipients' %}
              {% if card_image != blank %}{{ card_image | image_url: width: 600 | image_tag: loading: 'lazy', widths: '180, 300, 450, 600', sizes: '(min-width: 750px) 16vw, 40vw' }}{% endif %}
            {% endunless %}
            <span>{{ block.settings.title | default: block.settings.collection.title | escape }}</span>
          </a>
        {% endif %}
      {% endfor %}
    </div>
  {% endif %}
</section>
{% stylesheet %}
  .cv-discovery { padding-block: 28px; color: #302c35; }
  .cv-discovery__heading { text-align: center; position: relative; margin-bottom: 20px; }
  .cv-discovery__heading h2 { font-family: Georgia, 'Times New Roman', serif; font-weight: 400; font-size: clamp(28px, 3vw, 40px); line-height: 1.2; letter-spacing: -.6px; margin: 0 0 8px; }
  .cv-discovery__heading p { margin: 0; font-size: 14px; line-height: 1.5; }
  .cv-pill { display: inline-flex; align-items: center; justify-content: center; gap: 8px; border: 1px solid #655f66; border-radius: 30px; min-height: 44px; padding: 10px 18px; font-size: 14px; color: inherit; text-decoration: none; }
  .cv-pill:hover { background: #eee7e4; }
  .cv-discovery a:focus-visible { outline: 2px solid #88283f; outline-offset: 4px; }
  .cv-discovery__items { display: grid; grid-template-columns: repeat(6,minmax(0,1fr)); gap: 16px; }
  .cv-discovery__item { color: inherit; text-decoration: none; text-align: center; font-size: 14px; min-width: 0; }
  .cv-discovery__item img { width: 100%; aspect-ratio: 1; object-fit: cover; border-radius: 8px; margin-bottom: 10px; }
  .cv-discovery--occasions .cv-discovery__item img { border-radius: 50%; }
  .cv-discovery--recipients .cv-discovery__items { display: flex; flex-wrap: wrap; justify-content: center; gap: 8px; }
  .cv-discovery--recipients { padding-block: 40px; }
  .cv-discovery--products .cv-discovery__heading { text-align: left; display: flex; justify-content: space-between; align-items: center; gap: 16px; }
  .cv-discovery--products h2, .cv-discovery--confidence h2, .cv-discovery--recipients h2, .cv-discovery--occasions h2 { font-family: var(--font-body--family); font-size: 30px; }
  .cv-discovery__products { display: grid; grid-template-columns: repeat(4,minmax(0,1fr)); gap: 28px 16px; margin: 0; padding: 0; --resource-card-corner-radius: 8px; }
  .cv-discovery__products li { min-width: 0; }
  .cv-discovery__products .resource-card__title { overflow: hidden; white-space: nowrap; text-overflow: ellipsis; font-size: 14px; }
  .cv-discovery--confidence .cv-discovery__items { grid-template-columns: repeat(4,minmax(0,1fr)); }
  .cv-confidence { border: 1px solid #dedad5; border-radius: 8px; padding: 20px 16px; text-align: center; }
  .cv-confidence svg { margin: 0 auto 10px; }
  .cv-confidence h3 { font-family: var(--font-body--family); font-size: 16px; margin: 0 0 10px; }
  .cv-confidence p, .cv-confidence a { font-size: 14px; line-height: 1.5; margin: 0; }
  .cv-confidence a { display: inline-block; margin-top: 8px; color: inherit; }
  @media(max-width:749px) {
    .cv-discovery { padding-block: 24px; }
    .cv-discovery__items { display: flex; overflow-x: auto; scroll-snap-type: x mandatory; gap: 12px; padding-bottom: 8px; }
    .cv-discovery__item { flex: 0 0 40%; scroll-snap-align: start; }
    .cv-discovery--recipients .cv-discovery__item { flex: 0 0 auto; }
    .cv-discovery--confidence .cv-discovery__items { display: grid; grid-template-columns: repeat(2,minmax(0,1fr)); }
    .cv-discovery__products { grid-template-columns: repeat(2,minmax(0,1fr)); gap: 24px 12px; }
    .cv-discovery__heading h2 { font-size: 27px; }
    .cv-confidence { padding: 16px 12px; }
  }
{% endstylesheet %}
{% schema %}
{
  "name":"Gift discovery", "disabled_on":{"groups":["header","footer"]},
  "settings":[
    {"type":"select","id":"layout","label":"Layout","options":[{"value":"categories","label":"Category cards"},{"value":"products","label":"Products"},{"value":"recipients","label":"Recipient buttons"},{"value":"occasions","label":"Round occasion cards"},{"value":"confidence","label":"Confidence cards"}],"default":"categories"},
    {"type":"text","id":"heading","label":"Heading","default":"Find your perfect gift"},
    {"type":"text","id":"description","label":"Description"},
    {"type":"collection","id":"collection","label":"Product collection"},
    {"type":"url","id":"link","label":"View all link"}
  ],
  "blocks":[{"type":"item","name":"Item","settings":[
    {"type":"text","id":"title","label":"Title"},{"type":"collection","id":"collection","label":"Collection"},
    {"type":"image_picker","id":"image","label":"Image"},{"type":"product","id":"product","label":"Product image fallback"},{"type":"url","id":"link","label":"Link override"},
    {"type":"textarea","id":"text","label":"Confidence description"},
    {"type":"select","id":"icon","label":"Confidence icon","options":[{"value":"payment","label":"Payment"},{"value":"delivery","label":"Delivery"},{"value":"privacy","label":"Privacy"},{"value":"gift","label":"Gift"}],"default":"gift"}
  ]}], "max_blocks":12,"presets":[{"name":"Gift discovery"}]
}
{% endschema %}
