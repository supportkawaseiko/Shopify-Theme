{%- liquid
  assign section_settings = section.settings
  assign metafield_namespace = section_settings.metafield_namespace | strip
  assign metafield_key = section_settings.metafield_key | strip
  assign features_metafield = blank
  assign features = blank

  if metafield_namespace != blank and metafield_key != blank
    assign features_metafield = closest.product.metafields[metafield_namespace][metafield_key]
    assign features = features_metafield.value
  endif

  assign image_field_key = section_settings.image_field | strip
  assign title_field_key = section_settings.title_field | strip
  assign body_field_key = section_settings.body_field | strip
  assign max_items = section_settings.max_items
-%}

{%- if features != blank -%}
  <section
    class="product-features section section--{{ section_settings.section_width }} spacing-style"
    style="
      {% render 'spacing-style', settings: section_settings %}
      --product-features-background: {{ section_settings.background_color | default: 'transparent' }};
      --product-features-card-background: {{ section_settings.card_background_color | default: 'rgb(var(--color-background-rgb))' }};
      --product-features-border-color: {{ section_settings.border_color | default: 'rgb(var(--color-foreground-rgb) / 0.12)' }};
      --product-features-border-radius: {{ section_settings.border_radius | default: 8 }}px;
    "
  >
    <div class="product-features__inner">
      {%- if section_settings.heading != blank or section_settings.subheading != blank -%}
        <div class="product-features__header">
          {%- if section_settings.heading != blank -%}
            <h2 class="product-features__heading">{{ section_settings.heading | escape }}</h2>
          {%- endif -%}

          {%- if section_settings.subheading != blank -%}
            <div class="product-features__subheading rte">
              {{ section_settings.subheading }}
            </div>
          {%- endif -%}
        </div>
      {%- endif -%}

      <div class="product-features__grid">
        {%- for feature in features limit: max_items -%}
          {%- liquid
            assign image_field = blank
            assign image = blank
            if image_field_key != blank
              assign image_field = feature[image_field_key]
              assign image = image_field.value | default: image_field
            endif

            assign title_field = blank
            assign title = blank
            if title_field_key != blank
              assign title_field = feature[title_field_key]
              assign title = title_field.value | default: title_field
            endif

            assign body_field = blank
            if body_field_key != blank
              assign body_field = feature[body_field_key]
            endif
          -%}

          {%- if image != blank or title != blank or body_field != blank -%}
            <article class="product-features__item">
              {%- if image != blank -%}
                <div class="product-features__media">
                  {{
                    image
                    | image_url: width: 900
                    | image_tag:
                      widths: '240, 320, 480, 640, 800, 900',
                      sizes: '(min-width: 990px) 25vw, (min-width: 750px) 50vw, 100vw',
                      loading: 'lazy',
                      class: 'product-features__image'
                  }}
                </div>
              {%- endif -%}

              <div class="product-features__content">
                {%- if title != blank -%}
                  <h3 class="product-features__title">{{ title | escape }}</h3>
                {%- endif -%}

                {%- if body_field != blank -%}
                  <div class="product-features__text rte">
                    {%- if body_field.type contains 'rich_text' -%}
                      {{ body_field | metafield_tag }}
                    {%- else -%}
                      {{ body_field.value | default: body_field }}
                    {%- endif -%}
                  </div>
                {%- endif -%}
              </div>
            </article>
          {%- endif -%}
        {%- endfor -%}
      </div>
    </div>
  </section>
{%- endif -%}

{% stylesheet %}
  .product-features {
    background: var(--product-features-background);
  }

  .product-features__inner {
    display: grid;
    gap: var(--gap-xl);
  }

  .product-features__header {
    display: grid;
    gap: var(--gap-xs);
    margin-inline: auto;
    max-width: 48rem;
    text-align: center;
  }

  .product-features__heading {
    font-size: var(--font-h2--size);
    line-height: var(--font-h2--line-height);
    margin: 0;
  }

  .product-features__subheading {
    color: rgb(var(--color-foreground-rgb) / var(--opacity-subdued-text));
    font-size: var(--font-paragraph--size);
    line-height: var(--font-paragraph--line-height);
  }

  .product-features__subheading > * {
    margin-block: 0;
  }

  .product-features__grid {
    display: grid;
    gap: var(--gap-md);
    grid-template-columns: repeat(4, minmax(0, 1fr));
  }

  .product-features__item {
    background: var(--product-features-card-background);
    border: 1px solid var(--product-features-border-color);
    border-radius: var(--product-features-border-radius);
    display: grid;
    grid-template-rows: auto 1fr;
    min-width: 0;
    overflow: hidden;
  }

  .product-features__media {
    aspect-ratio: 4 / 3;
    background: rgb(var(--color-foreground-rgb) / 0.04);
    overflow: hidden;
  }

  .product-features__image {
    display: block;
    height: 100%;
    object-fit: cover;
    width: 100%;
  }

  .product-features__content {
    align-content: start;
    display: grid;
    gap: var(--gap-xs);
    padding: var(--padding-md);
  }

  .product-features__title {
    font-size: var(--font-h5--size);
    line-height: var(--font-h5--line-height);
    margin: 0;
  }

  .product-features__text {
    color: rgb(var(--color-foreground-rgb) / var(--opacity-subdued-text));
    font-size: var(--font-paragraph-small--size);
    line-height: var(--font-paragraph--line-height);
  }

  .product-features__text > * {
    margin-block: 0;
  }

  @media screen and (max-width: 989px) {
    .product-features__grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media screen and (max-width: 599px) {
    .product-features__grid {
      grid-template-columns: 1fr;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Product features",
  "class": "section-wrapper",
  "disabled_on": {
    "groups": ["header", "footer"]
  },
  "settings": [
    {
      "type": "header",
      "content": "Content"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Product features"
    },
    {
      "type": "richtext",
      "id": "subheading",
      "label": "Subheading",
      "default": "<p>Explore the details that make this product easy to personalize, wear and gift.</p>"
    },
    {
      "type": "header",
      "content": "Product metafield"
    },
    {
      "type": "text",
      "id": "metafield_namespace",
      "label": "Namespace",
      "default": "custom"
    },
    {
      "type": "text",
      "id": "metafield_key",
      "label": "Key",
      "default": "product_features",
      "info": "Use a product metafield that references a list of feature metaobjects."
    },
    {
      "type": "header",
      "content": "Metaobject fields"
    },
    {
      "type": "text",
      "id": "image_field",
      "label": "Image field key",
      "default": "image"
    },
    {
      "type": "text",
      "id": "title_field",
      "label": "Title field key",
      "default": "title"
    },
    {
      "type": "text",
      "id": "body_field",
      "label": "Body field key",
      "default": "description"
    },
    {
      "type": "range",
      "id": "max_items",
      "label": "Maximum features",
      "min": 1,
      "max": 8,
      "step": 1,
      "default": 4
    },
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "select",
      "id": "section_width",
      "label": "Section width",
      "options": [
        {
          "value": "page-width",
          "label": "Page"
        },
        {
          "value": "full-width",
          "label": "Full"
        }
      ],
      "default": "page-width"
    },
    {
      "type": "header",
      "content": "Appearance"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Background color",
      "alpha": true,
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "card_background_color",
      "label": "Card background color",
      "alpha": true,
      "default": "#fbf6f0"
    },
    {
      "type": "color",
      "id": "border_color",
      "label": "Border color",
      "alpha": true,
      "default": "#e3d8cc"
    },
    {
      "type": "range",
      "id": "border_radius",
      "label": "Border radius",
      "min": 0,
      "max": 24,
      "step": 1,
      "unit": "px",
      "default": 8
    },
    {
      "type": "header",
      "content": "Padding"
    },
    {
      "type": "range",
      "id": "padding-block-start",
      "label": "Top",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 48
    },
    {
      "type": "range",
      "id": "padding-block-end",
      "label": "Bottom",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 48
    }
  ],
  "presets": [
    {
      "name": "Product features",
      "category": "Product"
    }
  ]
}
{% endschema %}
