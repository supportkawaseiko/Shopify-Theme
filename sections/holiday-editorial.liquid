{% if section.settings.layout == 'marquee' %}
  <div class="holiday-editorial__marquee" style="--editorial-bg: {{ section.settings.background }}; --editorial-text: {{ section.settings.color }};" aria-label="{{ section.settings.heading | escape }}">
    <div aria-hidden="true">{% for i in (1..16) %}<span>{{ section.settings.heading | escape }} <span class="holiday-editorial__star">✦</span></span>{% endfor %}</div>
  </div>
{% else %}
  <section class="holiday-editorial" style="--editorial-bg: {{ section.settings.background }}; --editorial-text: {{ section.settings.color }};">
    <h2>{{ section.settings.heading | escape }}</h2>
    <div class="holiday-editorial__cards holiday-editorial__cards--{{ section.settings.layout }}">
      {% for block in section.blocks %}
        {% assign card_image = block.settings.image | default: block.settings.collection.image | default: block.settings.collection.products.first.featured_image %}
        {% assign card_link = block.settings.link | default: block.settings.collection.url %}
        <article {{ block.shopify_attributes }}>
          {% if card_link != blank %}<a href="{{ card_link }}" aria-label="{{ block.settings.title | escape }}">{% endif %}
          {% if block.settings.image == blank and block.settings.collection != blank and section.settings.layout == 'gallery' %}
            <div class="holiday-editorial__collage">{% for product in block.settings.collection.products limit: 4 %}{% if product.featured_image != blank %}{{ product.featured_image | image_url: width: 600 | image_tag: loading: 'lazy', widths: '180, 300, 600', sizes: '(min-width: 750px) 15vw, 40vw' }}{% endif %}{% endfor %}</div>
          {% elsif card_image != blank %}{{ card_image | image_url: width: 900 | image_tag: widths: '300, 600, 900', sizes: '(min-width: 750px) 30vw, 80vw', loading: 'lazy' }}{% endif %}
          {% if block.settings.title != blank %}<h3>{{ block.settings.title | escape }}</h3>{% endif %}
          {% if block.settings.text != blank %}<p>{{ block.settings.text | escape }}</p>{% endif %}
          {% if card_link != blank %}</a>{% endif %}
        </article>
      {% endfor %}
    </div>
  </section>
{% endif %}
{% stylesheet %}
  .holiday-editorial { background: var(--editorial-bg); color: var(--editorial-text); padding: 48px 32px; }
  .holiday-editorial h2 { text-align: center; font: 400 clamp(28px,3.6vw,48px)/1.2 Georgia,serif; margin: 0 0 32px; }
  .holiday-editorial__cards { max-width: 1600px; margin: auto; display: grid; grid-template-columns: repeat(3,minmax(0,1fr)); gap: 32px; }
  .holiday-editorial__cards--confidence { grid-template-columns: repeat(4,minmax(0,1fr)); gap: 16px; }
  .holiday-editorial article { min-width: 0; text-align: center; }
  .holiday-editorial a { display: block; color: inherit; text-decoration: none; }
  .holiday-editorial a:focus-visible { outline: 2px solid currentColor; outline-offset: 4px; }
  .holiday-editorial img { display: block; width: 100%; aspect-ratio: 1; object-fit: cover; border-radius: 12px; }
  .holiday-editorial h3 { font-size: 18px; margin: 16px 0 8px; }
  .holiday-editorial__collage { display: grid; grid-template-columns: repeat(2,minmax(0,1fr)); gap: 4px; border-radius: 12px; overflow: hidden; }
  .holiday-editorial__collage img { border-radius: 0; }
  .holiday-editorial p { font-size: 14px; line-height: 1.6; }
  .holiday-editorial__cards--confidence img { object-fit: contain; }
  .holiday-editorial__marquee { background: var(--editorial-bg); color: var(--editorial-text); overflow: hidden; padding-block: 10px; }
  .holiday-editorial__marquee > div { width: max-content; display: flex; animation: holiday-editorial-scroll 45s linear infinite; font-size: 14px; }
  .holiday-editorial__star { display: inline-block; margin-inline: 24px; }
  @keyframes holiday-editorial-scroll { to { transform: translateX(-50%); } }
  @media(prefers-reduced-motion:reduce) { .holiday-editorial__marquee > div { animation: none; } }
  @media(max-width:749px) { .holiday-editorial { padding: 28px 16px; } .holiday-editorial__cards--gallery { display: flex; overflow-x: auto; scroll-snap-type: x mandatory; gap: 16px; } .holiday-editorial__cards--gallery article { flex: 0 0 80%; scroll-snap-align: start; } .holiday-editorial__cards--confidence { grid-template-columns: repeat(2,minmax(0,1fr)); } }
{% endstylesheet %}
{% schema %}
{"name":"Holiday editorial","disabled_on":{"groups":["header","footer"]},"settings":[{"type":"select","id":"layout","label":"Layout","options":[{"value":"marquee","label":"Scrolling text strip"},{"value":"gallery","label":"Three editorial images"},{"value":"confidence","label":"Four trust cards"}],"default":"gallery"},{"type":"text","id":"heading","label":"Heading","default":"You Might Like This"},{"type":"color","id":"background","label":"Background","default":"#fff9f5"},{"type":"color","id":"color","label":"Text","default":"#2b2325"}],"max_blocks":4,"blocks":[{"type":"card","name":"Image card","settings":[{"type":"image_picker","id":"image","label":"Image or collage"},{"type":"collection","id":"collection","label":"Collection"},{"type":"url","id":"link","label":"Link override"},{"type":"text","id":"title","label":"Title"},{"type":"textarea","id":"text","label":"Description"}]}],"presets":[{"name":"Holiday · Editorial images","blocks":[{"type":"card"},{"type":"card"},{"type":"card"}]},{"name":"Holiday · Scrolling strip","settings":{"layout":"marquee","heading":"CHRISTMAS GIFTS","background":"#88283f","color":"#ffffff"}}]}
{% endschema %}
