{% comment %}
  Hippolord FAQ Help Center
  Designed for Shopify Horizon
{% endcomment %}

<section
  class="hippo-faq"
  data-section-id="{{ section.id }}"
  style="
    --faq-bg: {{ section.settings.background }};
    --faq-hero-bg: {{ section.settings.hero_background }};
    --faq-card-bg: {{ section.settings.card_background }};
    --faq-border: {{ section.settings.border_color }};
    --faq-text: {{ section.settings.text_color }};
    --faq-muted: {{ section.settings.muted_color }};
    --faq-accent: {{ section.settings.accent_color }};
    --faq-accent-soft: {{ section.settings.accent_soft }};
    --faq-contact-bg: {{ section.settings.contact_background }};
    --faq-contact-text: {{ section.settings.contact_text_color }};
    --faq-radius: {{ section.settings.corner_radius }}px;
    --faq-width: {{ section.settings.content_width }}px;
  "
>

  <!-- HERO -->
  <div class="hippo-faq__hero">
    <div class="hippo-faq__hero-inner">

      {% if section.settings.eyebrow != blank %}
        <div class="hippo-faq__eyebrow">
          {{ section.settings.eyebrow }}
        </div>
      {% endif %}

      {% if section.settings.heading != blank %}
        <h1 class="hippo-faq__heading">
          {{ section.settings.heading }}
        </h1>
      {% endif %}

      {% if section.settings.subheading != blank %}
        <div class="hippo-faq__subheading">
          {{ section.settings.subheading }}
        </div>
      {% endif %}

      <div class="hippo-faq__search-wrap">

        <svg
          class="hippo-faq__search-icon"
          viewBox="0 0 24 24"
          aria-hidden="true"
        >
          <circle cx="11" cy="11" r="7"></circle>
          <path d="m20 20-4-4"></path>
        </svg>

        <input
          class="hippo-faq__search"
          type="search"
          autocomplete="off"
          placeholder="{{ section.settings.search_placeholder | escape }}"
          aria-label="{{ section.settings.search_placeholder | escape }}"
          data-faq-search
        >

        <button
          class="hippo-faq__search-clear"
          type="button"
          aria-label="Clear search"
          data-faq-clear
          hidden
        >
          ×
        </button>

      </div>

    </div>
  </div>


  <div class="hippo-faq__content">

    <!-- CATEGORIES -->
    <div class="hippo-faq__categories">

      {% if section.settings.categories_heading != blank %}
        <h2 class="hippo-faq__section-heading">
          {{ section.settings.categories_heading }}
        </h2>
      {% endif %}

      {% if section.settings.categories_text != blank %}
        <div class="hippo-faq__section-description">
          {{ section.settings.categories_text }}
        </div>
      {% endif %}

      <div class="hippo-faq__category-grid">

        {% assign category_numbers = "1,2,3,4,5,6,7,8" | split: "," %}

        {% for number in category_numbers %}

          {% assign label_key = "category_" | append: number | append: "_label" %}
          {% assign image_key = "category_" | append: number | append: "_image" %}
          {% assign desc_key = "category_" | append: number | append: "_description" %}

          {% assign category_label = section.settings[label_key] %}
          {% assign category_image = section.settings[image_key] %}
          {% assign category_description = section.settings[desc_key] %}

          {% if category_label != blank %}

            <button
              type="button"
              class="hippo-faq__category"
              data-faq-category="cat{{ number }}"
              data-category-label="{{ category_label | escape }}"
              aria-pressed="false"
            >

              <div class="hippo-faq__category-icon">

                {% if category_image != blank %}

                  {{
                    category_image
                    | image_url: width: 160
                    | image_tag:
                      loading: 'lazy',
                      widths: '40, 60, 80, 120, 160',
                      alt: category_label
                  }}

                {% else %}

                  <svg viewBox="0 0 24 24" aria-hidden="true">
                    <circle cx="12" cy="12" r="9"></circle>
                    <path d="M9.8 9a2.4 2.4 0 0 1 4.5 1.2c0 1.8-2.3 2.1-2.3 3.8"></path>
                    <path d="M12 17.5h.01"></path>
                  </svg>

                {% endif %}

              </div>

              <div class="hippo-faq__category-title">
                {{ category_label }}
              </div>

              {% if category_description != blank %}
                <div class="hippo-faq__category-description">
                  {{ category_description }}
                </div>
              {% endif %}

              <div class="hippo-faq__category-arrow">
                →
              </div>

            </button>

          {% endif %}

        {% endfor %}

      </div>

    </div>


    <!-- MOST ASKED -->
    <div class="hippo-faq__most" data-faq-most-section>

      {% if section.settings.most_heading != blank %}
        <h2 class="hippo-faq__section-heading">
          {{ section.settings.most_heading }}
        </h2>
      {% endif %}

      <div class="hippo-faq__accordion">

        {% assign has_most = false %}

        {% for block in section.blocks %}

          {% if block.settings.most_asked and block.settings.question != blank %}

            {% assign has_most = true %}

            <details
              class="hippo-faq__item"
              {{ block.shopify_attributes }}
            >

              <summary class="hippo-faq__question">

                <span>
                  {{ block.settings.question }}
                </span>

                <span class="hippo-faq__plus" aria-hidden="true"></span>

              </summary>

              <div class="hippo-faq__answer">
                {{ block.settings.answer }}
              </div>

            </details>

          {% endif %}

        {% endfor %}

        {% unless has_most %}
          <div class="hippo-faq__empty-editor">
            Mark FAQ blocks as “Most asked” to display them here.
          </div>
        {% endunless %}

      </div>

    </div>


    <!-- ALL FAQ -->
    <div class="hippo-faq__all" data-faq-all-section>

      <div class="hippo-faq__all-header">

        <div>

          <div class="hippo-faq__small-label">
            {{ section.settings.all_label }}
          </div>

          <h2
            class="hippo-faq__section-heading hippo-faq__all-heading"
            data-faq-list-heading
            data-default-heading="{{ section.settings.all_heading | escape }}"
          >
            {{ section.settings.all_heading }}
          </h2>

        </div>

        <button
          type="button"
          class="hippo-faq__view-all"
          data-faq-view-all
          hidden
        >
          ← {{ section.settings.view_all_text }}
        </button>

      </div>


      <div class="hippo-faq__accordion" data-faq-list>

        {% for block in section.blocks %}

          {% if block.settings.question != blank %}

            <details
              class="hippo-faq__item"
              data-faq-item
              data-category="{{ block.settings.category }}"
              {{ block.shopify_attributes }}
            >

              <summary class="hippo-faq__question">

                <span>
                  {{ block.settings.question }}
                </span>

                <span class="hippo-faq__plus" aria-hidden="true"></span>

              </summary>

              <div class="hippo-faq__answer">
                {{ block.settings.answer }}
              </div>

            </details>

          {% endif %}

        {% endfor %}

      </div>


      <div
        class="hippo-faq__no-results"
        data-faq-no-results
        hidden
      >
        <div class="hippo-faq__no-results-icon">?</div>

        <strong>
          {{ section.settings.no_results_heading }}
        </strong>

        <span>
          {{ section.settings.no_results_text }}
        </span>
      </div>

    </div>

  </div>


  <!-- CONTACT -->
  {% if section.settings.show_contact %}

    <div class="hippo-faq__contact">

      <div class="hippo-faq__contact-inner">

        {% if section.settings.contact_eyebrow != blank %}
          <div class="hippo-faq__contact-eyebrow">
            {{ section.settings.contact_eyebrow }}
          </div>
        {% endif %}

        {% if section.settings.contact_heading != blank %}
          <h2 class="hippo-faq__contact-heading">
            {{ section.settings.contact_heading }}
          </h2>
        {% endif %}

        {% if section.settings.contact_description != blank %}
          <div class="hippo-faq__contact-description">
            {{ section.settings.contact_description }}
          </div>
        {% endif %}

        {% if section.settings.contact_button != blank
          and section.settings.contact_link != blank
        %}
          <a
            href="{{ section.settings.contact_link }}"
            class="hippo-faq__contact-button"
          >
            {{ section.settings.contact_button }}
            <span aria-hidden="true">→</span>
          </a>
        {% endif %}

      </div>

    </div>

  {% endif %}

</section>


{% style %}

/* ======================================================
   BASE
====================================================== */

#shopify-section-{{ section.id }} .hippo-faq {
  background: var(--faq-bg);
  color: var(--faq-text);
  font-family: var(--font-body--family);
}

#shopify-section-{{ section.id }} .hippo-faq *,
#shopify-section-{{ section.id }} .hippo-faq *::before,
#shopify-section-{{ section.id }} .hippo-faq *::after {
  box-sizing: border-box;
}


/* ======================================================
   HERO
====================================================== */

#shopify-section-{{ section.id }} .hippo-faq__hero {
  background: var(--faq-hero-bg);
  padding: 72px 20px 68px;
}

#shopify-section-{{ section.id }} .hippo-faq__hero-inner {
  width: min(100%, 800px);
  margin: 0 auto;
  text-align: center;
}

#shopify-section-{{ section.id }} .hippo-faq__eyebrow {
  margin-bottom: 12px;

  font-family: var(--font-subheading--family);
  font-weight: var(--font-subheading--weight);

  font-size: 12px;
  letter-spacing: .14em;
  line-height: 1.2;

  text-transform: uppercase;

  color: var(--faq-accent);
}

#shopify-section-{{ section.id }} .hippo-faq__heading {
  margin: 0;

  font-family: var(--font-heading--family);
  font-style: var(--font-heading--style);
  font-weight: var(--font-heading--weight);

  font-size: clamp(38px, 5vw, 58px);
  line-height: .98;
  letter-spacing: -.04em;

  color: var(--faq-text);
}

#shopify-section-{{ section.id }} .hippo-faq__subheading {
  max-width: 620px;
  margin: 18px auto 0;

  font-size: 16px;
  line-height: 1.6;

  color: var(--faq-muted);
}

#shopify-section-{{ section.id }} .hippo-faq__subheading p {
  margin: 0;
}


/* ======================================================
   SEARCH
====================================================== */

#shopify-section-{{ section.id }} .hippo-faq__search-wrap {
  position: relative;

  width: min(100%, 650px);
  margin: 32px auto 0;
}

#shopify-section-{{ section.id }} .hippo-faq__search {
  display: block;

  width: 100%;
  height: 58px;

  padding: 0 54px;

  border: 1px solid var(--faq-border);
  border-radius: 12px;

  outline: none;

  background: var(--faq-card-bg);
  color: var(--faq-text);

  font: inherit;
  font-size: 15px;

  transition:
    border-color .2s ease,
    box-shadow .2s ease;
}

#shopify-section-{{ section.id }} .hippo-faq__search::placeholder {
  color: var(--faq-muted);
}

#shopify-section-{{ section.id }} .hippo-faq__search:focus {
  border-color: var(--faq-accent);

  box-shadow:
    0 0 0 3px
    color-mix(in srgb, var(--faq-accent) 12%, transparent);
}

#shopify-section-{{ section.id }} .hippo-faq__search-icon {
  position: absolute;

  left: 20px;
  top: 50%;

  width: 20px;
  height: 20px;

  transform: translateY(-50%);

  fill: none;
  stroke: var(--faq-muted);
  stroke-width: 1.8;
  stroke-linecap: round;

  pointer-events: none;
}

#shopify-section-{{ section.id }} .hippo-faq__search-clear {
  position: absolute;

  right: 13px;
  top: 50%;

  width: 34px;
  height: 34px;

  transform: translateY(-50%);

  border: 0;
  border-radius: 50%;

  cursor: pointer;

  background: transparent;
  color: var(--faq-muted);

  font-size: 23px;
  line-height: 1;
}


/* ======================================================
   CONTENT
====================================================== */

#shopify-section-{{ section.id }} .hippo-faq__content {
  width: min(calc(100% - 40px), var(--faq-width));

  margin: 0 auto;

  padding: 72px 0;
}

#shopify-section-{{ section.id }} .hippo-faq__categories,
#shopify-section-{{ section.id }} .hippo-faq__most,
#shopify-section-{{ section.id }} .hippo-faq__all {
  scroll-margin-top: 100px;
}

#shopify-section-{{ section.id }} .hippo-faq__most,
#shopify-section-{{ section.id }} .hippo-faq__all {
  width: min(100%, 920px);
  margin-left: auto;
  margin-right: auto;
}

#shopify-section-{{ section.id }} .hippo-faq__most {
  margin-top: 76px;
}

#shopify-section-{{ section.id }} .hippo-faq__all {
  margin-top: 76px;
}


/* ======================================================
   SECTION HEADINGS
====================================================== */

#shopify-section-{{ section.id }} .hippo-faq__section-heading {
  margin: 0;

  text-align: center;

  font-family: var(--font-heading--family);
  font-style: var(--font-heading--style);
  font-weight: var(--font-heading--weight);

  font-size: 32px;
  line-height: 1.05;
  letter-spacing: -.025em;

  color: var(--faq-text);
}

#shopify-section-{{ section.id }} .hippo-faq__section-description {
  max-width: 620px;

  margin: 12px auto 32px;

  text-align: center;

  font-size: 14px;
  line-height: 1.55;

  color: var(--faq-muted);
}


/* ======================================================
   CATEGORY GRID
====================================================== */

#shopify-section-{{ section.id }} .hippo-faq__category-grid {
  display: grid;

  grid-template-columns:
    repeat(4, minmax(0, 1fr));

  gap: 14px;

  margin-top: 34px;
}

#shopify-section-{{ section.id }} .hippo-faq__category {
  position: relative;

  min-height: 170px;

  padding: 24px 18px;

  border: 1px solid var(--faq-border);
  border-radius: var(--faq-radius);

  cursor: pointer;

  background: var(--faq-card-bg);
  color: var(--faq-text);

  text-align: left;

  transition:
    transform .2s ease,
    border-color .2s ease,
    background-color .2s ease;
}

#shopify-section-{{ section.id }} .hippo-faq__category-icon {
  width: 42px;
  height: 42px;

  display: flex;
  align-items: center;
  justify-content: center;

  margin-bottom: 18px;

  color: var(--faq-accent);
}

#shopify-section-{{ section.id }} .hippo-faq__category-icon img {
  width: 100%;
  height: 100%;

  display: block;

  object-fit: contain;
}

#shopify-section-{{ section.id }} .hippo-faq__category-icon svg {
  width: 30px;
  height: 30px;

  fill: none;
  stroke: currentColor;
  stroke-width: 1.6;
  stroke-linecap: round;
  stroke-linejoin: round;
}

#shopify-section-{{ section.id }} .hippo-faq__category-title {
  padding-right: 22px;

  font-family: var(--font-heading--family);
  font-weight: var(--font-heading--weight);

  font-size: 16px;
  line-height: 1.15;
}

#shopify-section-{{ section.id }} .hippo-faq__category-description {
  margin-top: 7px;
  padding-right: 20px;

  font-size: 12px;
  line-height: 1.45;

  color: var(--faq-muted);
}

#shopify-section-{{ section.id }} .hippo-faq__category-arrow {
  position: absolute;

  right: 18px;
  bottom: 18px;

  color: var(--faq-accent);

  font-size: 20px;

  transition: transform .2s ease;
}

#shopify-section-{{ section.id }} .hippo-faq__category[aria-pressed="true"] {
  border-color: var(--faq-accent);
  background: var(--faq-accent-soft);
}

@media (hover: hover) and (pointer: fine) {

  #shopify-section-{{ section.id }} .hippo-faq__category:hover {
    transform: translateY(-2px);

    border-color: var(--faq-accent);
  }

  #shopify-section-{{ section.id }} .hippo-faq__category:hover
  .hippo-faq__category-arrow {
    transform: translateX(3px);
  }

}


/* ======================================================
   FAQ HEADER
====================================================== */

#shopify-section-{{ section.id }} .hippo-faq__all-header {
  display: flex;

  align-items: flex-end;
  justify-content: space-between;

  gap: 24px;

  margin-bottom: 24px;
}

#shopify-section-{{ section.id }} .hippo-faq__all-header
.hippo-faq__section-heading {
  text-align: left;
}

#shopify-section-{{ section.id }} .hippo-faq__small-label {
  margin-bottom: 7px;

  font-family: var(--font-subheading--family);
  font-weight: var(--font-subheading--weight);

  font-size: 11px;
  line-height: 1;

  letter-spacing: .12em;
  text-transform: uppercase;

  color: var(--faq-accent);
}

#shopify-section-{{ section.id }} .hippo-faq__view-all {
  padding: 0;

  border: 0;

  cursor: pointer;

  background: transparent;
  color: var(--faq-accent);

  font: inherit;
  font-weight: 600;
  font-size: 13px;

  white-space: nowrap;
}


/* ======================================================
   ACCORDION
====================================================== */

#shopify-section-{{ section.id }} .hippo-faq__accordion {
  display: flex;
  flex-direction: column;

  gap: 10px;

  margin-top: 28px;
}

#shopify-section-{{ section.id }} .hippo-faq__item {
  border: 1px solid var(--faq-border);
  border-radius: var(--faq-radius);

  overflow: hidden;

  background: var(--faq-card-bg);
}

#shopify-section-{{ section.id }} .hippo-faq__item[open] {
  border-color:
    color-mix(
      in srgb,
      var(--faq-accent) 45%,
      var(--faq-border)
    );
}

#shopify-section-{{ section.id }} .hippo-faq__question {
  min-height: 62px;

  display: flex;

  align-items: center;
  justify-content: space-between;

  gap: 20px;

  padding: 17px 20px;

  cursor: pointer;

  list-style: none;

  font-family: var(--font-heading--family);
  font-weight: 700;

  font-size: 15px;
  line-height: 1.35;

  color: var(--faq-text);
}

#shopify-section-{{ section.id }} .hippo-faq__question::-webkit-details-marker {
  display: none;
}

#shopify-section-{{ section.id }} .hippo-faq__question::marker {
  display: none;
  content: "";
}

#shopify-section-{{ section.id }} .hippo-faq__plus {
  position: relative;

  width: 18px;
  height: 18px;

  flex: 0 0 18px;
}

#shopify-section-{{ section.id }} .hippo-faq__plus::before,
#shopify-section-{{ section.id }} .hippo-faq__plus::after {
  content: "";

  position: absolute;

  left: 50%;
  top: 50%;

  background: var(--faq-accent);

  transform: translate(-50%, -50%);

  transition: transform .2s ease;
}

#shopify-section-{{ section.id }} .hippo-faq__plus::before {
  width: 14px;
  height: 1.5px;
}

#shopify-section-{{ section.id }} .hippo-faq__plus::after {
  width: 1.5px;
  height: 14px;
}

#shopify-section-{{ section.id }} .hippo-faq__item[open]
.hippo-faq__plus::after {
  transform:
    translate(-50%, -50%)
    rotate(90deg);
}

#shopify-section-{{ section.id }} .hippo-faq__answer {
  padding:
    0 52px
    20px 20px;

  color: var(--faq-muted);

  font-size: 14px;
  line-height: 1.65;
}

#shopify-section-{{ section.id }} .hippo-faq__answer p:first-child {
  margin-top: 0;
}

#shopify-section-{{ section.id }} .hippo-faq__answer p:last-child {
  margin-bottom: 0;
}

#shopify-section-{{ section.id }} .hippo-faq__answer a {
  color: var(--faq-accent);

  text-decoration: underline;
  text-underline-offset: 3px;
}


/* ======================================================
   NO RESULTS
====================================================== */

#shopify-section-{{ section.id }} .hippo-faq__no-results {
  padding: 44px 20px;

  text-align: center;

  border: 1px dashed var(--faq-border);
  border-radius: var(--faq-radius);

  color: var(--faq-muted);
}

#shopify-section-{{ section.id }} .hippo-faq__no-results-icon {
  width: 44px;
  height: 44px;

  display: flex;
  align-items: center;
  justify-content: center;

  margin: 0 auto 14px;

  border-radius: 50%;

  background: var(--faq-accent-soft);
  color: var(--faq-accent);

  font-family: var(--font-heading--family);
  font-weight: 800;

  font-size: 20px;
}

#shopify-section-{{ section.id }} .hippo-faq__no-results strong,
#shopify-section-{{ section.id }} .hippo-faq__no-results span {
  display: block;
}

#shopify-section-{{ section.id }} .hippo-faq__no-results strong {
  color: var(--faq-text);

  font-family: var(--font-heading--family);

  font-size: 17px;
}

#shopify-section-{{ section.id }} .hippo-faq__no-results span {
  margin-top: 6px;

  font-size: 13px;
}


/* ======================================================
   CONTACT CTA
====================================================== */

#shopify-section-{{ section.id }} .hippo-faq__contact {
  padding: 68px 20px;

  background: var(--faq-contact-bg);
  color: var(--faq-contact-text);
}

#shopify-section-{{ section.id }} .hippo-faq__contact-inner {
  width: min(100%, 760px);

  margin: 0 auto;

  text-align: center;
}

#shopify-section-{{ section.id }} .hippo-faq__contact-eyebrow {
  margin-bottom: 12px;

  font-size: 11px;
  font-weight: 700;

  letter-spacing: .14em;
  text-transform: uppercase;

  opacity: .8;
}

#shopify-section-{{ section.id }} .hippo-faq__contact-heading {
  margin: 0;

  font-family: var(--font-heading--family);
  font-style: var(--font-heading--style);
  font-weight: var(--font-heading--weight);

  font-size: clamp(30px, 4vw, 42px);
  line-height: 1;

  letter-spacing: -.03em;
}

#shopify-section-{{ section.id }} .hippo-faq__contact-description {
  max-width: 560px;

  margin: 16px auto 0;

  font-size: 14px;
  line-height: 1.6;

  opacity: .85;
}

#shopify-section-{{ section.id }} .hippo-faq__contact-description p {
  margin: 0;
}

#shopify-section-{{ section.id }} .hippo-faq__contact-button {
  min-height: 48px;

  display: inline-flex;

  align-items: center;
  justify-content: center;

  gap: 13px;

  margin-top: 26px;

