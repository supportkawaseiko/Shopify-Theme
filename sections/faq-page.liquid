<script>
(() => {
  function initHippolordFaq(root) {
    if (!root || root.dataset.faqInitialized === 'true') return;

    root.dataset.faqInitialized = 'true';

    const searchInput = root.querySelector('[data-faq-search]');
    const clearButton = root.querySelector('[data-faq-clear]');
    const categoryButtons = [...root.querySelectorAll('[data-faq-category]')];
    const faqItems = [...root.querySelectorAll('[data-faq-item]')];

    const mostSection = root.querySelector('[data-faq-most-section]');
    const allSection = root.querySelector('[data-faq-all-section]');

    const listHeading = root.querySelector('[data-faq-list-heading]');
    const defaultHeading = listHeading?.dataset.defaultHeading || 'All questions';

    const viewAllButton = root.querySelector('[data-faq-view-all]');
    const noResults = root.querySelector('[data-faq-no-results]');

    let selectedCategory = '';

    const closeAll = () => {
      faqItems.forEach(item => {
        item.open = false;
      });
    };

    const resetCategoryButtons = () => {
      categoryButtons.forEach(button => {
        button.setAttribute('aria-pressed', 'false');
      });
    };

    const updateNoResults = visibleCount => {
      if (!noResults) return;

      noResults.hidden = visibleCount !== 0;
    };

    const showAllQuestions = () => {
      selectedCategory = '';

      resetCategoryButtons();

      faqItems.forEach(item => {
        item.hidden = false;
      });

      if (listHeading) {
        listHeading.textContent = defaultHeading;
      }

      if (viewAllButton) {
        viewAllButton.hidden = true;
      }

      if (mostSection) {
        mostSection.hidden = false;
      }

      updateNoResults(faqItems.length);
      closeAll();
    };

    const filterCategory = (category, label) => {
      selectedCategory = category;

      if (searchInput) {
        searchInput.value = '';
      }

      if (clearButton) {
        clearButton.hidden = true;
      }

      resetCategoryButtons();

      const activeButton = categoryButtons.find(
        button => button.dataset.faqCategory === category
      );

      if (activeButton) {
        activeButton.setAttribute('aria-pressed', 'true');
      }

      let visibleCount = 0;

      faqItems.forEach(item => {
        const matches = item.dataset.category === category;

        item.hidden = !matches;

        if (matches) visibleCount++;
      });

      if (listHeading) {
        listHeading.textContent = label;
      }

      if (viewAllButton) {
        viewAllButton.hidden = false;
      }

      if (mostSection) {
        mostSection.hidden = true;
      }

      updateNoResults(visibleCount);
      closeAll();

      if (allSection) {
        allSection.scrollIntoView({
          behavior: 'smooth',
          block: 'start'
        });
      }
    };

    const searchFaq = query => {
      const value = query
        .trim()
        .toLocaleLowerCase();

      if (clearButton) {
        clearButton.hidden = value.length === 0;
      }

      if (!value) {
        showAllQuestions();
        return;
      }

      selectedCategory = '';

      resetCategoryButtons();

      if (mostSection) {
        mostSection.hidden = true;
      }

      if (viewAllButton) {
        viewAllButton.hidden = true;
      }

      if (listHeading) {
        listHeading.textContent = 'Search results';
      }

      let visibleCount = 0;

      faqItems.forEach(item => {
        const text = item.textContent
          .replace(/\s+/g, ' ')
          .toLocaleLowerCase();

        const matches = text.includes(value);

        item.hidden = !matches;

        if (matches) visibleCount++;
      });

      updateNoResults(visibleCount);
      closeAll();
    };

    categoryButtons.forEach(button => {
      button.addEventListener('click', () => {
        filterCategory(
          button.dataset.faqCategory,
          button.dataset.categoryLabel
        );
      });
    });

    searchInput?.addEventListener('input', event => {
      searchFaq(event.target.value);
    });

    clearButton?.addEventListener('click', () => {
      if (!searchInput) return;

      searchInput.value = '';
      searchInput.focus();

      showAllQuestions();

      clearButton.hidden = true;
    });

    viewAllButton?.addEventListener('click', () => {
      if (searchInput) {
        searchInput.value = '';
      }

      if (clearButton) {
        clearButton.hidden = true;
      }

      showAllQuestions();
    });
  }

  const initialize = () => {
    document
      .querySelectorAll('.hippo-faq')
      .forEach(initHippolordFaq);
  };

  if (document.readyState === 'loading') {
    document.addEventListener(
      'DOMContentLoaded',
      initialize,
      { once: true }
    );
  } else {
    initialize();
  }

  document.addEventListener(
    'shopify:section:load',
    event => {
      const root = event.target.querySelector('.hippo-faq');

      initHippolordFaq(root);
    }
  );
})();
</script>


{% if section.settings.enable_schema %}

  <script type="application/ld+json">
  {
    "@context": "https://schema.org",
    "@type": "FAQPage",
    "mainEntity": [
      {% for block in section.blocks %}
        {
          "@type": "Question",
          "name": {{ block.settings.question | strip_html | json }},
          "acceptedAnswer": {
            "@type": "Answer",
            "text": {{ block.settings.answer | strip_html | json }}
          }
        }{% unless forloop.last %},{% endunless %}
      {% endfor %}
    ]
  }
  </script>

{% endif %}


