<section class="holiday-faq section section--page-width">
  <h2>{{ section.settings.heading | escape }}</h2>
  {% for block in section.blocks %}
    <details {{ block.shopify_attributes }}>
      <summary>{{ block.settings.question | escape }} <span aria-hidden="true">+</span></summary>
      <div class="rte">{{ block.settings.answer }}</div>
    </details>
  {% endfor %}
</section>
{% stylesheet %}
  .holiday-faq { padding-block: 40px 56px; color: var(--color-foreground); }
  .holiday-faq h2 { font: 400 clamp(28px,3vw,40px)/1.2 Georgia,serif; margin: 0 0 24px; text-align: center; }
  .holiday-faq details { width: 100%; max-width: 800px; margin-inline: auto; border-bottom: 1px solid rgb(var(--color-foreground-rgb) / .2); }
  .holiday-faq summary { display: flex; align-items: center; justify-content: space-between; gap: 16px; padding: 20px 0; min-height: 48px; cursor: pointer; list-style: none; font-weight: 600; }
  .holiday-faq summary::-webkit-details-marker { display: none; }
  .holiday-faq summary:focus-visible { outline: 2px solid currentColor; outline-offset: 4px; }
  .holiday-faq details[open] summary span { transform: rotate(45deg); }
  .holiday-faq .rte { padding-bottom: 20px; line-height: 1.6; }
{% endstylesheet %}
{% schema %}
{"name":"Holiday FAQ","disabled_on":{"groups":["header","footer"]},"settings":[{"type":"text","id":"heading","label":"Heading","default":"A little help with your holiday gifts"}],"blocks":[{"type":"question","name":"Question","settings":[{"type":"text","id":"question","label":"Question","default":"How do I personalize my gift?"},{"type":"richtext","id":"answer","label":"Answer","default":"<p>Choose a product, then enter the names or upload the photos requested on its product page.</p>"}]}],"max_blocks":12,"presets":[{"name":"Holiday FAQ","blocks":[{"type":"question"}]}]}
{% endschema %}
