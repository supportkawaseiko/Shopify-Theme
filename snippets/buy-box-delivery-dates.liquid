{% liquid
  assign earliest_days = buy_box.settings.default_eta_min_days | default: 4 | plus: 0
  assign latest_days = buy_box.settings.default_eta_max_days | default: 12 | at_least: earliest_days
  assign business_days = true
  assign eta_source = 'default'
  for child in buy_box.blocks
    if child.type != 'shipping-eta'
      continue
    endif
    assign eta_metafield = product.metafields[child.settings.metafield_namespace][child.settings.metafield_key]
    assign selected_eta = blank
    assign country_key = child.settings.country_code_field | default: 'country_code'
    if eta_metafield.type contains 'list.'
      for entry in eta_metafield.value
        capture country_match
          render 'shipping-eta-country-match', eta: entry, country_key: country_key, country_code: localization.country.iso_code
        endcapture
        assign country_match = country_match | strip
        if country_match == 'true'
          assign selected_eta = entry
          break
        endif
      endfor
    else
      capture country_match
        render 'shipping-eta-country-match', eta: eta_metafield.value, country_key: country_key, country_code: localization.country.iso_code
      endcapture
      assign country_match = country_match | strip
      if country_match == 'true'
        assign selected_eta = eta_metafield.value
      endif
    endif
    if selected_eta == blank
      continue
    endif
    assign pmin_key = child.settings.processing_min_field | default: 'processing_min_days'
    assign pmax_key = child.settings.processing_max_field | default: 'processing_max_days'
    assign tmin_key = child.settings.transit_min_field | default: 'transit_min_days'
    assign tmax_key = child.settings.transit_max_field | default: 'transit_max_days'
    assign pmin = selected_eta[pmin_key].value | default: selected_eta[pmin_key]
    assign pmax = selected_eta[pmax_key].value | default: selected_eta[pmax_key]
    assign tmin = selected_eta[tmin_key].value | default: selected_eta[tmin_key]
    assign tmax = selected_eta[tmax_key].value | default: selected_eta[tmax_key]
    if pmin != blank and pmax != blank and tmin != blank and tmax != blank
      if pmin < 0 or pmax < pmin or tmin < 0 or tmax < tmin
        continue
      endif
      assign earliest_days = pmin | plus: tmin
      assign latest_days = pmax | plus: tmax
      assign business_days = false
      assign eta_source = 'metaobject'
      assign ep_key = child.settings.express_processing_min_field | default: 'express_processing_min_days'
      assign et_key = child.settings.express_transit_min_field | default: 'express_transit_min_days'
      assign ep = selected_eta[ep_key].value | default: selected_eta[ep_key]
      assign et = selected_eta[et_key].value | default: selected_eta[et_key]
      if ep != blank and et != blank
        assign express_days = ep | plus: et
        if ep >= 0 and et >= 0 and express_days < earliest_days
          assign earliest_days = express_days
        endif
      endif
      break
    endif
  endfor
  assign timestamp = 'now' | date: '%s' | plus: 0
  assign earliest_timestamp = timestamp
  assign latest_timestamp = timestamp
  assign counted_days = 0
  for day in (1..366)
    if counted_days >= latest_days
      break
    endif
    assign timestamp = timestamp | plus: 86400
    assign weekday = timestamp | date: '%u' | plus: 0
    if business_days == false or weekday < 6
      assign counted_days = counted_days | plus: 1
      if counted_days == earliest_days
        assign earliest_timestamp = timestamp
      endif
      assign latest_timestamp = timestamp
    endif
  endfor
%}
{% if latest_days > 0 and counted_days >= latest_days %}
  <div class="product-buy-box__delivery product-buy-box__delivery--estimate" data-eta-source="{{ eta_source }}" data-eta-country="{{ localization.country.iso_code }}">
    <p class="product-buy-box__eta">Estimated delivery <strong><time datetime="{{ latest_timestamp | date: '%Y-%m-%d' }}">{{ latest_timestamp | date: '%A, %B %-d' }}</time></strong></p>
    {% if earliest_days >= 0 and earliest_days < latest_days %}
      <p class="product-buy-box__fastest">Or fastest delivery <strong><time datetime="{{ earliest_timestamp | date: '%Y-%m-%d' }}">{{ earliest_timestamp | date: '%A, %B %-d' }}</time></strong></p>
    {% endif %}
  </div>
{% endif %}
