<script src="{{ 'dialog.js' | asset_url }}" type="module"></script>
<dialog-component class="cv-ship-selector">
  <button type="button" class="cv-ship-selector__trigger" on:click="/showDialog" aria-haspopup="dialog">
    <span class="cv-ship-to"><span class="cv-ship-to__label">Ship to</span><strong>{{ localization.country.name | escape }}</strong></span>
    <span class="svg-wrapper icon-caret" aria-hidden="true">{{ 'icon-caret.svg' | inline_asset_content }}</span>
  </button>
  <dialog ref="dialog" class="cv-ship-selector__panel dialog-modal" scroll-lock aria-labelledby="ShipLocationTitle-{{ section.id }}">
    <div class="cv-ship-selector__heading">
      <h2 class="cv-ship-selector__title" id="ShipLocationTitle-{{ section.id }}">Choose your location</h2>
      <button type="button" class="cv-ship-selector__close" aria-label="Close location selector" on:click="/closeDialog">{{ 'icon-close.svg' | inline_asset_content }}</button>
    </div>
    <div class="cv-ship-selector__body">
    <p>Delivery options may vary by location.</p>
    {% assign destination_form_id = 'ShippingDestination-' | append: section.id %}
    {% form 'localization', id: destination_form_id, class: 'cv-ship-selector__form' %}
      <label for="{{ destination_form_id }}-country">Country / region</label>
      <select name="country_code" id="{{ destination_form_id }}-country">
        {% for country in localization.available_countries %}
          <option value="{{ country.iso_code }}"{% if country.iso_code == localization.country.iso_code %} selected{% endif %}>{{ country.name | escape }}</option>
        {% endfor %}
      </select>
      <button type="submit">Done</button>
    {% endform %}
    </div>
  </dialog>
</dialog-component>
{% stylesheet %}
  .cv-ship-selector { position: relative; color: #2b2325; }
  .cv-ship-selector__trigger { display: flex; align-items: center; gap: 8px; padding: 7px 9px; border: 1px solid #d4c4c8; border-radius: 6px; background: #fff; cursor: pointer; list-style: none; text-transform: none; }
  .cv-ship-selector__trigger::-webkit-details-marker { display: none; }
  .cv-ship-selector__trigger > img { object-fit: contain; }
  .cv-ship-selector__trigger .icon-caret { width: 12px; height: 12px; }
  .cv-ship-selector__trigger:hover { border-color: #88283f; background: #fff4f6; }
  .cv-ship-selector__trigger:focus-visible { outline: 2px solid #88283f; outline-offset: 3px; }
  dialog.cv-ship-selector__panel { position: fixed; inset: 0; margin: auto; width: 380px; height: fit-content; max-height: calc(100dvh - 32px); max-width: calc(100vw - 32px); padding: 0; border: 1px solid #d4c4c8; border-radius: 10px; background: #fff; color: #2b2325; box-shadow: 0 10px 32px #2b23252e; font-size: 14px; line-height: 1.5; text-transform: none; }
  .cv-ship-selector__panel::backdrop { background: rgb(0 0 0 / .45); }
  dialog.cv-ship-selector__panel[open] { animation: cv-ship-fade-in .15s ease-out; }
  @keyframes cv-ship-fade-in { from { opacity: 0; } to { opacity: 1; } }
  .cv-ship-selector__heading { display: flex; align-items: center; justify-content: space-between; gap: 16px; padding: 16px 20px; background: #f4f1f2; border-bottom: 1px solid #e5dce0; }
  .cv-ship-selector__title { margin: 0; color: #2b2325; font-size: 17px; font-weight: 700; }
  .cv-ship-selector__close { display: grid; place-items: center; width: 32px; height: 32px; padding: 6px; border: 0; border-radius: 4px; background: transparent; color: #2b2325; cursor: pointer; }
  .cv-ship-selector__close svg { width: 20px; height: 20px; }
  .cv-ship-selector__body { padding: 18px 20px 20px; }
  .cv-ship-selector__panel p { margin: 6px 0 16px; color: #65575c; }
  .cv-ship-selector__form { display: grid; gap: 8px; }
  .cv-ship-selector__form label { color: #2b2325; font-weight: 600; }
  .cv-ship-selector__form select { width: 100%; min-width: 0; min-height: 44px; padding: 10px; border: 1px solid #a9969c; border-radius: 6px; color: #2b2325; background: #fff; font: inherit; }
  .cv-ship-selector__form select:focus-visible { outline: 2px solid #88283f; outline-offset: 2px; }
  .cv-ship-selector__form button { justify-self: end; min-height: 40px; margin-top: 12px; padding: 8px 22px; border: 0; border-radius: 22px; color: #fff; background: #88283f; font: inherit; font-weight: 600; cursor: pointer; }
  .cv-ship-selector__form button:is(:hover, :focus-visible) { background: #651c2e; }
  .cv-ship-selector__panel small { display: block; margin-top: 14px; color: #65575c; }
  @media (max-width: 749px) {
    .cv-ship-selector__trigger { width: 100%; justify-content: flex-start; }
    .cv-ship-selector__trigger .icon-caret { margin-inline-start: auto; }
  }
{% endstylesheet %}
