{%- doc -%}
  Product card layout styles. Kept in a standalone snippet so empty filtered grids
  can preload the styles before facets morph product cards into the section.

  @example
  {% render 'product-card-styles' %}
{%- enddoc -%}

{% stylesheet %}
  .product-grid__card.product-grid__card {
    display: flex;
    flex-flow: column nowrap;
    gap: var(--product-card-gap);
    align-items: var(--product-card-alignment);
    text-decoration: none;
    color: var(--color, var(--color-foreground));
    padding-block: var(--padding-block-start) var(--padding-block-end);
    padding-inline: var(--padding-inline-start) var(--padding-inline-end);
    overflow: hidden;
  }

  .product-grid__card .group-block > * {
    @media screen and (max-width: 749px) {
      flex-direction: column;
    }
  }

  /* Collection and product list cards have equal heights */
  :is(.product-grid__item, .resource-list__item) .product-card {
    display: grid;
    height: 100%;
  }

  /* Product card title truncation - applied on mobile regardless of view */
  @media screen and (max-width: 749px) {
    :is(.product-card, .product-grid__card) :is(h4, .h4) {
      display: -webkit-box;
      -webkit-box-orient: vertical;
      overflow: hidden;
      text-overflow: ellipsis;
      -webkit-line-clamp: 3;
    }
  }

  .product-card__placeholder-image svg {
    height: 100%;
  }

  .product-card__content slideshow-component {
    --cursor: pointer;
  }

  /* Collection cards use a compact catalogue layout with actions below the media. */
  .product-card--collection .product-card__content {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    grid-template-rows: auto minmax(3.25rem, auto) auto;
    column-gap: 0;
    row-gap: 0;
    align-content: start;
    overflow: visible;
  }

  .product-card--collection .product-card__content::before {
    content: '';
    grid-column: 1 / -1;
    grid-row: 3;
    align-self: start;
    border-top: 1px solid rgb(var(--color-border-rgb) / 0.45);
    pointer-events: none;
  }

  .product-card--collection .card-gallery {
    grid-column: 1 / -1;
    border-radius: var(--style-border-radius-sm);
    overflow: hidden;
  }

  .product-card--collection .product-card__content > a.contents {
    grid-column: 1 / -1;
    display: block;
    min-width: 0;
    padding-block: var(--padding-sm);
  }

  .product-card--collection .product-card__content > a.contents .text-block {
    width: 100%;
  }

  .product-card--collection .product-card__content > a.contents :is(p, h3, h4) {
    display: -webkit-box;
    min-height: 2.6em;
    overflow: hidden;
    font-weight: 600;
    line-height: 1.3;
    text-overflow: ellipsis;
    -webkit-box-orient: vertical;
    -webkit-line-clamp: 2;
  }

  .product-card--collection product-price {
    grid-column: 1;
    grid-row: 3;
    align-self: center;
    width: fit-content;
    min-width: 0;
    padding-block: var(--padding-sm);
    font-weight: 700;
  }

  .product-card--collection .collection-card__actions {
    grid-column: 2;
    grid-row: 3;
    align-self: stretch;
    display: flex;
    align-items: center;
    justify-content: flex-end;
    padding-block: var(--padding-sm);
    padding-inline-start: var(--gap-sm);
  }

  .product-card--collection .collection-card-actions,
  .product-card--collection .collection-card-actions product-form-component {
    display: block;
    width: 100%;
  }

  .product-card--collection .collection-card-actions__form {
    display: flex;
    align-items: center;
    justify-content: flex-end;
    gap: var(--gap-xs);
  }

  .product-card--collection .collection-card-actions__select-wrap {
    position: relative;
    flex: 1 1 5rem;
    min-width: 0;
  }

  .product-card--collection .collection-card-actions__select {
    width: 100%;
    height: 2.25rem;
    padding-inline: var(--padding-sm) 1.75rem;
    overflow: hidden;
    border: 1px solid rgb(var(--color-border-rgb) / 0.7);
    border-radius: 999px;
    background: transparent;
    color: currentcolor;
    font: inherit;
    font-size: 0.75rem;
    text-overflow: ellipsis;
    white-space: nowrap;
    appearance: none;
  }

  .product-card--collection .collection-card-actions__chevron {
    position: absolute;
    top: 50%;
    right: var(--padding-xs);
    width: 0.75rem;
    height: 0.75rem;
    translate: 0 -50%;
    pointer-events: none;
  }

  .product-card--collection .collection-card-actions__button {
    flex: 0 0 auto;
    min-width: 4rem;
    height: 2.25rem;
    padding-inline: var(--padding-sm);
    border-radius: 999px;
    font-size: 0.75rem;
  }

  .product-card--collection .collection-card-actions__button .add-to-cart-icon {
    width: 0.9rem;
    height: 0.9rem;
  }

  @media screen and (max-width: 749px) {
    .product-card--collection .product-card__content {
      grid-template-columns: auto minmax(0, 1fr);
      grid-template-rows: auto minmax(3.75rem, auto) auto;
      column-gap: 0;
    }

    .product-card--collection .collection-card__actions {
      grid-column: 2;
      padding-inline-start: var(--gap-xs);
    }

    .product-card--collection .collection-card-actions__form {
      gap: var(--gap-2xs);
    }

    .product-card--collection .collection-card-actions__button {
      min-width: 2.5rem;
      padding-inline: 0.5rem;
    }

    .product-card--collection .collection-card-actions__button .add-to-cart-icon {
      display: none;
    }
  }

  @media screen and (max-width: 749px) {
    .product-card slideshow-arrows .slideshow-control {
      display: none;
    }
  }
{% endstylesheet %}
